# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------------------------
# Field Repository web client — multi-stage image.
#
# BUILD FROM THE REPOSITORY ROOT, same as the backend:
#     docker build -f frontend/Dockerfile -t field-repository-frontend:local .
#
# This image exists for local full-stack work and for the day the web app has to live somewhere
# that is not Vercel. Vercel itself does NOT use it — it builds frontend/ with its own pipeline
# (docs/DEPLOYMENT_VERCEL.md), which is precisely why `output: "standalone"` is switched on HERE
# rather than in next.config.ts. That file explains the constraint in its own header: standalone
# mode emits a self-hosted Node server bundle, and Vercel's build errors out when it is set. So
# the container turns it on for the container build only, and the committed config stays the
# shape Vercel needs.
#
# What standalone buys: `.next/standalone` contains the server plus a traced, minimal copy of
# only the node_modules actually reached at run time. The runtime stage therefore never runs
# `npm install` and never carries the ~600 MB dependency tree the build needed.
# ---------------------------------------------------------------------------------------------

ARG NODE_VERSION=22


# =============================================================================================
# Stage 1 — deps: install node_modules, cached against the lockfile alone.
# =============================================================================================
FROM node:${NODE_VERSION}-alpine AS deps

WORKDIR /app

# Lockfile-only copy so an edit to a component does not reinstall the world.
COPY frontend/package.json frontend/package-lock.json ./

# `npm ci` rather than `npm install`: it installs exactly the locked tree and fails loudly if
# package.json and the lockfile have drifted, instead of silently resolving something new.
# devDependencies are needed here — typescript, tailwind and postcss all run during the build.
RUN npm ci --no-audit --no-fund


# =============================================================================================
# Stage 2 — builder: compile the app.
# =============================================================================================
FROM node:${NODE_VERSION}-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./

# The standalone switch. Written as a wrapper that re-exports the committed config with one field
# added, so every redirect, header and image-host rule stays in force and there is exactly one
# place they are maintained — the alternative, a second full config, would drift the moment
# somebody adds a security header to the real one.
RUN mv next.config.ts next.config.base.ts \
 && printf '%s\n' \
      'import type { NextConfig } from "next";' \
      'import base from "./next.config.base";' \
      '' \
      '// Generated by frontend/Dockerfile — container builds only. See that file for why this' \
      '// cannot live in next.config.base.ts (Vercel rejects standalone output).' \
      'const config: NextConfig = { ...base, output: "standalone" };' \
      'export default config;' \
      > next.config.ts

# NEXT_PUBLIC_* values are INLINED INTO THE BUNDLE at build time — they are not read from the
# container's environment at run time, so setting them in docker-compose's `environment:` block
# would do nothing at all. They have to arrive here, as build args, which also means changing the
# API URL requires a rebuild rather than a restart.
#
# The default points at the host's published backend port rather than at the compose service name
# because this value is executed by the BROWSER, which is outside the compose network and cannot
# resolve `api`.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ARG NEXT_PUBLIC_MAPTILER_API_KEY=
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL} \
    NEXT_PUBLIC_GOOGLE_CLIENT_ID=${NEXT_PUBLIC_GOOGLE_CLIENT_ID} \
    NEXT_PUBLIC_MAPTILER_API_KEY=${NEXT_PUBLIC_MAPTILER_API_KEY} \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

RUN npm run build


# =============================================================================================
# Stage 3 — runtime.
# =============================================================================================
FROM node:${NODE_VERSION}-alpine AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

WORKDIR /app

# node:alpine already ships an unprivileged `node` account (uid 1000); reusing it is one fewer
# thing to get wrong than inventing another.
USER node

# The three pieces standalone output splits into. Only the first is self-contained: the static
# chunks and the public assets are emitted outside the traced bundle and the server expects to
# find them at these exact paths.
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static

EXPOSE 3000

# A 3xx or a 404 still proves the server is answering — only a 5xx or a refused connection means
# it is not. `/` redirects unauthenticated visitors, so a probe that demanded 200 would flap.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:3000/').then(r => process.exit(r.status < 500 ? 0 : 1)).catch(() => process.exit(1))"]

# server.js is what `output: "standalone"` emits — a plain Node server. `next start` is not
# available here and would fail: the Next CLI is not part of the traced bundle.
CMD ["node", "server.js"]
