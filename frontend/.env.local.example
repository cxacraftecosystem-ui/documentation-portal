# ---------------------------------------------------------------------------------------------
# Field Repository — LOCAL DEVELOPMENT env template
#
#   PowerShell:  cd frontend; if (-not (Test-Path .env.local)) { Copy-Item .env.local.example .env.local }
#   bash:        cd frontend && cp -n .env.local.example .env.local
#
# `.env.local` is gitignored (`.gitignore` -> `*.local`) and takes priority over every other
# `.env*` file, so it is the right place for your personal keys. This `.example` file IS committed —
# keep placeholders only.
#
# Values below assume the local stack from the repo root README:
#   docker compose up -d          (Postgres on :55432, MinIO on :9000)
#   cd backend && uvicorn app.main:app --reload --port 8000
#   cd frontend && npm run dev    (Next.js on :3000)
#
# Variable reference with types/defaults/secrecy: docs/ENVIRONMENT.md
# ---------------------------------------------------------------------------------------------

# Backend origin — ORIGIN ONLY, no `/api` suffix and no trailing slash.
# lib/api.ts appends `/api` itself (`${NEXT_PUBLIC_API_URL}/api${path}`), so `http://localhost:8000/api`
# produces `http://localhost:8000/api/api/...` and every request 404s. This is the single most
# common misconfiguration in this project — check it first when "nothing loads".
#
# Use 127.0.0.1 rather than localhost if Node resolves `localhost` to ::1 while uvicorn is bound
# to IPv4 only (symptom: ECONNREFUSED on every call even though curl works).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where this dev server is reachable. No frontend code reads this — it is the BACKEND's variable of
# the same name (app/core/config.py), kept here so one value stays aligned with the port you pass to
# `npm run dev` and with the backend's BACKEND_CORS_ORIGINS. The CORS entry is what actually stops
# the browser blocking calls at preflight.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google web OAuth client ID. Optional locally — leave blank to sign in with the seeded
# email/password admin (backend/.env -> ADMIN_EMAIL / ADMIN_PASSWORD). If you do fill it in, use
# the SAME id as backend/.env -> GOOGLE_CLIENT_ID and add http://localhost:3000 to that client's
# "Authorized JavaScript origins" in the Google Cloud console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# MapTiler key for the map coordinate picker. Optional — without it the picker degrades to manual
# latitude/longitude entry, which is enough for local testing.
NEXT_PUBLIC_MAPTILER_API_KEY=
