# ---------------------------------------------------------------------------------------------
# Field Repository — web client environment template
#
# This file documents EVERY variable the Next.js app reads. It is committed, so it must never
# contain a real key. Two ways to use it:
#
#   * Local development -> copy `.env.local.example` to `.env.local` (localhost defaults, gitignored).
#   * Vercel            -> re-type these names in Project Settings -> Environment Variables.
#                          See `docs/DEPLOYMENT_VERCEL.md` for the click-path and exact values.
#
# Every variable here is prefixed `NEXT_PUBLIC_`, which means Next.js INLINES its value into the
# JavaScript bundle at build time. Consequences a junior developer must internalise:
#   1. Nothing here is a secret. Anyone can read these values with devtools. Never put an API
#      secret, a database URL, or an OAuth client *secret* in this file.
#   2. Changing a value in the Vercel dashboard does NOT affect the running site until you
#      REDEPLOY — the old value is already baked into the shipped bundle.
# ---------------------------------------------------------------------------------------------

# REQUIRED. Origin of the FastAPI backend — scheme + host (+ port), and NOTHING else.
#
# ⚠ THE ONE TRAP THAT KEEPS BITING: do NOT append `/api`, and do NOT leave a trailing slash.
# `frontend/lib/api.ts` builds every request as `${NEXT_PUBLIC_API_URL}/api${path}`, so
#   correct   https://d2b34i3e92al6i.cloudfront.net      -> https://…/api/artisans   ✅
#   wrong     https://d2b34i3e92al6i.cloudfront.net/api  -> https://…/api/api/artisans -> 404 ❌
#   wrong     https://d2b34i3e92al6i.cloudfront.net/     -> https://…//api/artisans   -> 404 ❌
# Every screen fails with a 404 or a blank list when this is wrong; the network tab shows the
# doubled `/api/api/` segment.
#
# Production (Vercel): https://d2b34i3e92al6i.cloudfront.net
# It MUST be https:// in production — an https:// Vercel page cannot call an http:// API
# (browsers block it as mixed content).
NEXT_PUBLIC_API_URL=https://d2b34i3e92al6i.cloudfront.net

# OPTIONAL for the web build. Public origin of this web app itself (scheme + host, no trailing
# slash). NOTE: no code under `frontend/` reads this today — it shares its name with the BACKEND
# variable (app/core/config.py) so a single value can be kept in sync across both apps and with the
# backend's BACKEND_CORS_ORIGINS entries. Setting it in Vercel is harmless and keeps the two in
# step, but it changes nothing in the shipped bundle.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# OPTIONAL (but required for Google sign-in). The Google **web** OAuth client ID — the same value
# the backend puts in GOOGLE_CLIENT_ID, because the backend verifies the ID token this client mints.
# Not a secret; the client *secret* is not used by this ID-token flow and must not be committed.
# Leave blank to hide the Google button and use email/password only.
# The deployed origin must also be listed under "Authorized JavaScript origins" for this client,
# otherwise Google Identity Services returns 403 and the button never renders.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# OPTIONAL. MapTiler API key for the map-based coordinate picker on the location fields
# (components/forms/LocationFields.tsx). Leave blank and the map is replaced by a note; latitude
# and longitude can still be typed in by hand, so this never blocks data entry.
# Restrict the key to your domains in the MapTiler dashboard — it ships in the browser bundle.
NEXT_PUBLIC_MAPTILER_API_KEY=
