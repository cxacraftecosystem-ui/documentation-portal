# ---------------------------------------------------------------------------------------------
# Field Repository — FastAPI backend environment template
#
#   PowerShell:  cd backend; if (-not (Test-Path .env)) { Copy-Item .env.example .env }
#
# `backend/.env` is gitignored and is the ONLY place real secrets belong locally. In production the
# whole file is stored as the `BACKEND_ENV` GitHub Actions secret and written to the EC2 box by
# `.github/workflows/deploy-backend.yml` (see backend/DEPLOY_AWS.md §5 and §8.2).
#
# Everything below maps 1:1 to a field in `app/core/config.py` unless the comment says otherwise.
# Variables shown commented-out are OPTIONAL — the code default in the comment applies when unset.
# Full table (required? default? secret?) for every service: docs/ENVIRONMENT.md
# ---------------------------------------------------------------------------------------------

# === Database (REQUIRED) ======================================================================
# Postgres connection string for Prisma. The Supabase REST URL is NOT a DATABASE_URL.
# Set this to the Supabase SESSION pooler URL (…pooler.supabase.com:5432): migrations need session
# mode for advisory locks and DDL. The running app automatically re-routes ITS OWN queries to the
# TRANSACTION pooler (:6543) — see DATABASE_USE_TRANSACTION_POOLER — so a couple of workers can't
# exhaust the 15-connection session pool (EMAXCONNSESSION).
# Local docker-compose value shown; replace with the Supabase URL for any shared/deployed database.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/field_repository

# Runtime pooling. Defaults are correct for Supabase; the values only matter for pooler URLs.
# DATABASE_USE_TRANSACTION_POOLER=true   # default true; set false to keep runtime on session mode
# DATABASE_CONNECTION_LIMIT=10           # default 10, PER uvicorn worker. Do NOT raise to 40 —
#                                        # that exhausted the pooler's 200-client ceiling and
#                                        # crash-looped startup (EMAXCONN).
# DATABASE_POOL_TIMEOUT=10               # seconds to wait for a pooled connection; unset = Prisma default (10)
# DATABASE_REQUIRE_SSL=                  # unset = automatic: sslmode=require is appended for a REMOTE
#                                        # host, and NOT for loopback/private hosts (docker-compose
#                                        # Postgres ships no certificate). true/false forces either
#                                        # answer; a URL that already carries an ssl* parameter always
#                                        # wins. See config.py::_with_explicit_sslmode — libpq's
#                                        # default sslmode=prefer silently falls back to plaintext.

# === Auth (REQUIRED) ==========================================================================
# HMAC secret signing the JWTs handed to the web and Android clients. SECRET.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it invalidates every issued token, i.e. logs everyone out.
JWT_SECRET=change-this-to-a-long-random-secret
# Access-token lifetime in minutes. Default 10080 (7 days).
JWT_EXPIRES_MINUTES=10080
# JWT_ALGORITHM=HS256                    # default HS256; only HS256/HS384/HS512 are accepted. Anything
#                                        # else (notably "none" or an RS*/ES* algorithm) makes the app
#                                        # refuse to start — that is the algorithm-confusion guard.
# ALLOW_WEAK_JWT_SECRET=false            # default false. LOCAL DEVELOPMENT ONLY: lets the API boot with
#                                        # a short/placeholder JWT_SECRET instead of refusing to start.
#                                        # Never set it in a deployed environment.

# === Object storage (REQUIRED) ================================================================
# Credentials of the IAM user (or MinIO account) allowed to PutObject/GetObject/DeleteObject on
# the media bucket. AWS_SECRET_ACCESS_KEY is SECRET. Local values below are the MinIO defaults
# from docker-compose.yml.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Region of the bucket. Default us-east-1; production uses ap-south-1.
AWS_REGION=us-east-1
# Bucket that stores every uploaded image/video/audio/document. Production: fieldrepo-media-626159998512
AWS_S3_BUCKET=field-repository
# S3-compatible endpoint override. Set ONLY for MinIO/other non-AWS storage. LEAVE IT UNSET on AWS
# so boto3 signs against the dual-stack regional endpoint (s3.dualstack.<region>.amazonaws.com),
# which is what makes uploads work on IPv6-only mobile networks.
AWS_S3_ENDPOINT=http://localhost:9000
# Public base URL used to build readable media links. On AWS use the DUAL-STACK host, e.g.
# https://fieldrepo-media-626159998512.s3.dualstack.ap-south-1.amazonaws.com
AWS_S3_PUBLIC_BASE_URL=http://localhost:9000/field-repository
# Server-side-encryption algorithm requested on uploads the API itself starts (multipart create).
# The code's default is AES256 (SSE-S3), which is right on AWS — but this file configures MinIO
# (see AWS_S3_ENDPOINT above), and MinIO with no KMS backend rejects the header outright, so a
# multipart upload fails locally while working in production. Left EMPTY here so local dev matches
# the rest of this file; set AWS_S3_SSE_ALGORITHM=AES256 (or aws:kms, which needs a key policy that
# also grants the media IAM user) when pointing at real S3.
AWS_S3_SSE_ALGORITHM=

# === Security response headers ================================================================
# HSTS is emitted by app.main.SecurityHeadersMiddleware. Defaults are correct for local dev.
# In PRODUCTION set SECURITY_FORCE_HSTS=true: the live path is
# browser --HTTPS--> CloudFront --HTTP--> nginx --HTTP--> uvicorn, and nginx overwrites
# X-Forwarded-Proto with its own scheme, so the app cannot otherwise tell the viewer used TLS.
# SECURITY_HSTS_ENABLED=true             # default true; false removes Strict-Transport-Security
# SECURITY_HSTS_MAX_AGE=63072000         # default 63072000 (2 years), in seconds
# SECURITY_FORCE_HSTS=false              # default false; set true on the EC2 box behind CloudFront

# Interactive API docs: /docs, /redoc and /openapi.json. OFF by default, because the schema lists
# every route, parameter and model field — including admin-only ones — to anyone who asks, and it
# was served unauthenticated in production. Turn it on locally when you want the Swagger page; do
# NOT set it in the deployed environment.
# BACKEND_EXPOSE_DOCS=true               # default false

# === Web origins / CORS =======================================================================
# Public origin of the Next.js app. Default http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated list of browser origins allowed to call this API (FastAPI CORSMiddleware).
# Exact origins only: scheme + host (+ port), no trailing slash, no path, no wildcard.
# Add EVERY Vercel origin you use — production domain, custom domain, and any preview URL you test:
#   BACKEND_CORS_ORIGINS=https://your-project.vercel.app,https://repo.example.org,http://localhost:3000
# Symptom of a missing entry: the browser console reports a blocked CORS preflight and every call
# fails, while the same request works from curl/Postman.
BACKEND_CORS_ORIGINS=http://localhost:3000

# === Google sign-in (optional) ================================================================
# Google **web** OAuth client ID; the backend verifies ID tokens minted by the web app and the
# Android app against it. Same value as the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID. Not secret.
GOOGLE_CLIENT_ID=
# Additional Android OAuth client ID, only if tokens arrive with that audience. Not secret.
GOOGLE_ANDROID_CLIENT_ID=

# === Roles / bootstrap admin ==================================================================
# REQUIRED. Google account that is permanently MASTER_ADMIN (rank 60) — settings, OTA releases,
# managing other admins. There is no default; the app will not start without it.
MASTER_ADMIN_EMAIL=ankits1802@gmail.com
# Display name for that account. Default "Ankit Kumar".
MASTER_ADMIN_NAME=Ankit Kumar
# Tier assigned to brand-new self-registered Google accounts on the six-tier ladder.
# Default CROWDSOURCE_VOLUNTEER (lowest); set RESEARCHER to restore the old open-signup behaviour.
DEFAULT_SIGNUP_ROLE=CROWDSOURCE_VOLUNTEER

# === Speech-to-text and AI (all optional) =====================================================
# Provider chain, highest priority first: ElevenLabs Scribe -> Deepgram Nova-3 -> OpenAI Whisper.
# Whichever keys are present are tried in that order, with automatic failover. All keys are SECRET.
# With none of them set, uploads still succeed — transcripts simply stay empty.
ELEVENLABS_API_KEY=
# Default scribe_v1.
ELEVENLABS_STT_MODEL=scribe_v1
DEEPGRAM_API_KEY=
# Default nova-3 (handles code-switched Hindi + English natively).
DEEPGRAM_STT_MODEL=nova-3
# The OpenAI key's PRIMARY role is transcript refinement/translation to English; it only transcribes
# when neither dedicated STT key is configured.
OPENAI_API_KEY=
# Default whisper-1.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Chat model that rewrites raw transcripts into clean interviewer/interviewee dialogue. Default gpt-4o-mini.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Gemini powers the "Document using grid" measurement reader. Single legacy key and/or a rotating
# pool: GEMINI_API_KEYS takes any number of comma- or newline-separated keys and the worker
# round-robins and fails over across them. Add more keys at any time without changing code.
GEMINI_API_KEY=
GEMINI_API_KEYS=
# Vision model id for grid measurement. Default gemini-2.5-flash-lite — the old gemini-1.5-flash
# id now 404s, so pin an id that still exists when overriding.
GEMINI_MEASUREMENT_MODEL=gemini-2.5-flash-lite
# MapTiler key. Read by the backend only so a single .env can feed both apps; the browser gets it
# from the frontend build. Optional — without it the map picker degrades to manual lat/long entry.
NEXT_PUBLIC_MAPTILER_API_KEY=

# === Media processing queue ===================================================================
# The durable transcription/measurement worker. In production this must be FALSE in the web
# service's environment — a separate `fieldrepo-queue` systemd unit runs `python -m app.worker`
# so ffmpeg + AI work never blocks HTTP requests (backend/DEPLOY_AWS.md §3).
# MEDIA_QUEUE_WORKER_ENABLED=true        # default true (fine for local dev, false on the web box)
# MEDIA_QUEUE_INTERVAL_SECONDS=5         # default 5.0 — poll interval between queue sweeps
# MEDIA_QUEUE_BATCH_SIZE=3               # default 3 — jobs claimed per sweep
# MEDIA_QUEUE_JOB_MAX_ATTEMPTS=3         # default 3 — retries before a job is marked failed
#                                        # (throttling, HTTP 429/503, requeues without burning one)

# === Optional scaling layer (app/scale) =======================================================
# EVERY line in this section is commented out, and that is the supported configuration. With none
# of them set the API runs the code paths it runs today: no cache, no rate limiter in the
# middleware stack, exact counts, offset pagination, one database connection. The package is not
# even imported — `python -c "import sys, app.main; print([k for k in sys.modules if
# k.startswith('app.scale')])"` prints an empty list.
#
# Full documentation — what each variable buys, what it costs, how to verify it took effect:
# backend/app/scale/README.md. Check any configuration with `python -m app.scale.selfcheck`.

# --- Response cache ---------------------------------------------------------------------------
# Off by default. The `memory` backend is in-process, bounded by BOTH entry count and bytes, and
# needs no service; `redis` is only worth it when more than one process must share an
# invalidation, and needs `pip install -e '.[cache]'` (it is NOT a core dependency — a missing
# package logs one line and falls back to the memory cache rather than failing to boot).
# SCALE_CACHE_ENABLED=false              # default false
# SCALE_CACHE_BACKEND=memory             # default memory; the only other value is redis
# SCALE_CACHE_TTL_SECONDS=30             # default 30. Keep it SHORT: correctness comes from
#                                        # explicit invalidation on write, and the TTL only bounds
#                                        # how long a response may lag a change THIS process never
#                                        # saw (the queue service, another worker, a psql session).
# SCALE_CACHE_MAX_ENTRIES=512            # default 512
# SCALE_CACHE_MAX_BYTES=33554432         # default 32 MiB — the ceiling on a 1 GiB box
# SCALE_CACHE_MAX_ENTRY_BYTES=1048576    # default 1 MiB — bigger responses are never stored
# SCALE_CACHE_SINGLEFLIGHT_TIMEOUT_SECONDS=10   # default 10 — how long a request waits on another
#                                        # request already loading the same key before running the
#                                        # query itself (stops an expired hot key firing N queries)
# SCALE_REDIS_URL=                       # SECRET (may embed a password). Local docker:
#                                        # redis://localhost:56379/0 after
#                                        # `docker compose --profile cache up -d redis`
# SCALE_REDIS_TIMEOUT_SECONDS=0.5        # default 0.5 — a cache that stalls a request is worse
#                                        # than no cache; after 3 failures the process stops
#                                        # calling Redis until it restarts

# --- Keyset (cursor) pagination -----------------------------------------------------------------
# Off means every cursor argument is ignored and routes page with the skip/take they use today.
# On, an adopting route also returns `nextCursor`; `total`/`page`/`pages` keep their meanings, so
# the UI can go on rendering page numbers.
# SCALE_KEYSET_PAGINATION_ENABLED=false  # default false

# --- Approximate row totals -----------------------------------------------------------------------
# Off means every list total is an exact COUNT. At the default threshold NOTHING CHANGES on today's
# data either: the largest table holds ~925 rows against a threshold of 5000, so the flag arms a
# behaviour for later without altering a single number now.
# SCALE_APPROX_COUNT_ENABLED=false       # default false
# SCALE_APPROX_COUNT_THRESHOLD=5000      # default 5000 — exact at or below, estimated above

# --- Request rate limiting ---------------------------------------------------------------------
# Off means the middleware is NOT ADDED to the app at all. A courtesy backstop for a small box (a
# phone stuck in a sync loop, a runaway script) — not a security control; that belongs at
# CloudFront/WAF. /health* and CORS preflights are always exempt.
# SCALE_RATE_LIMIT_ENABLED=false         # default false
# SCALE_RATE_LIMIT_REQUESTS=120          # default 120 per window, per bearer token (else per IP)
# SCALE_RATE_LIMIT_WINDOW_SECONDS=60     # default 60

# --- Read replica --------------------------------------------------------------------------------
# SECRET. Unset (the default) means every query uses the one connection this app has always used.
# Setting it starts a SECOND Prisma query-engine child process — tens of megabytes on a 1 GiB box —
# so set it only when a real replica exists. Never used for a read-back-after-write path.
# DATABASE_READ_REPLICA_URL=

# === Optional Supabase REST/Admin access ======================================================
# Not read by the API today; kept so a deployment that also needs Supabase REST has one place to
# put the values. SUPABASE_SECRET_KEY is SECRET and belongs in runtime secrets only.
SUPABASE_REST_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# === Seed script values (scripts/seed_admin.py) ===============================================
# Read directly via os.getenv by the seeding script, not by config.py. Creates the first
# email/password admin so you can log in before Google OAuth is configured.
# ADMIN_PASSWORD is SECRET — keep it out of shared docs and change it before real data is entered.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Repository Admin
ADMIN_PASSWORD=
