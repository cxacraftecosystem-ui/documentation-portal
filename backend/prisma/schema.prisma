  lockedAt       DateTime?
  lockedBy       String?
  runAfter       DateTime                 @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
