generator client {
  provider                    = "prisma-client-py"
  interface                   = "asyncio"
  recursive_type_depth        = 5
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Six-tier role ladder, strictly ordered by privilege:
/// MASTER_ADMIN > ADMIN > PROFESSOR > RESEARCHER > FIELD_CONTRIBUTOR > CROWDSOURCE_VOLUNTEER.
/// Each tier inherits everything below it; grantable can* booleans lift single capabilities.
enum UserRole {
  MASTER_ADMIN
  ADMIN
  PROFESSOR
  RESEARCHER
  FIELD_CONTRIBUTOR
  CROWDSOURCE_VOLUNTEER
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum RecordStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  /// Reviewer sent the record back with comments (reviewNotes); creator edits and resubmits.
  NEEDS_REVISION
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  OTHER
}

enum ProductType {
  FINISHED_GOOD
  SAMPLE
  RAW_MATERIAL
  COMPONENT
  PACKAGING
  OTHER
}

enum MarketDemand {
  LOW
  MEDIUM
  HIGH
  SEASONAL
  UNKNOWN
}

enum MakerType {
  ARTISAN
  LOCAL_BLACKSMITH
  CARPENTER
  WORKSHOP
  FACTORY
  UNKNOWN
  OTHER
}

enum TraditionType {
  TRADITIONAL
  MODERN
  HYBRID
  UNKNOWN
}

enum ReviewRecordType {
  ARTISAN
  WORKSHOP
  PRODUCT
  TOOL
  // Processes and interviews carry a status and can be pinned PENDING by the late-submission
  // gate, so they have to be reviewable like any other record.
  PROCESS
  QUESTIONNAIRE
  MEDIA
}

enum MediaProcessingJobType {
  TRANSCRIPTION
  MEASUREMENT
}

enum MediaProcessingJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProcessStepType {
  SEQUENTIAL
  GROUP
}

/// Tiers of cross-researcher data access, strictly increasing in privilege:
/// DOWNLOAD (minimum) < COMMENT (medium) < EDIT (maximum). Each tier includes everything below it.
enum DataAccessTier {
  DOWNLOAD
  COMMENT
  EDIT
}

/// Lifecycle of a DataAccessGrant row. PENDING = a request from the grantee awaiting the owner's
/// decision; GRANTED = active; DENIED = owner refused; REVOKED = owner withdrew a previously active grant.
enum DataAccessStatus {
  PENDING
  GRANTED
  DENIED
  REVOKED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  role         UserRole     @default(RESEARCHER)
  authProvider AuthProvider @default(LOCAL)
  canManageQuestionnaire Boolean @default(false)
  canManageCrafts        Boolean @default(false)
  canManageWorkshops     Boolean @default(false)
  canReview              Boolean @default(false)
  canViewProvenance      Boolean @default(false)
  canDownloadDataset     Boolean @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  artisans  Artisan[]              @relation("ArtisanCreatedBy")
  crafts    Craft[]                @relation("CraftCreatedBy")
  workshops Workshop[]             @relation("WorkshopCreatedBy")
  products  ProductDocumentation[] @relation("ProductCreatedBy")
  tools     ToolDocumentation[]    @relation("ToolCreatedBy")
  processes Process[]              @relation("ProcessCreatedBy")
  media     MediaFile[]            @relation("MediaUploadedBy")
  requestedMediaProcessingJobs MediaProcessingJob[] @relation("MediaProcessingRequestedBy")
  reviews   ReviewLog[]            @relation("ReviewReviewer")
  questionnaireInterviews QuestionnaireInterview[] @relation("QuestionnaireCreatedBy")
  questionnaireResponses QuestionnaireResponse[] @relation("QuestionnaireAnsweredBy")
  appReleases AppRelease[] @relation("AppReleasePublishedBy")
  feedback    Feedback?    @relation("FeedbackUser")
  preferences UserPreference? @relation("UserPreferenceUser")
  sectionStatusesSet QuestionnaireSectionStatus[] @relation("SectionStatusSetBy")
  workshopAssignments     WorkshopAssignment[] @relation("WorkshopAssignmentUser")
  workshopAssignmentsMade WorkshopAssignment[] @relation("WorkshopAssignmentAssignedBy")
  workshopAccessRequests  WorkshopAssignment[] @relation("WorkshopAssignmentRequestedBy")
  workshopAccessDecisions WorkshopAssignment[] @relation("WorkshopAssignmentDecidedBy")
  managedSecretsUpdated   ManagedSecret[]      @relation("ManagedSecretUpdatedBy")
  dataAccessAsOwner   DataAccessGrant[] @relation("DataAccessOwner")
  dataAccessAsGrantee DataAccessGrant[] @relation("DataAccessGrantee")
  dataAccessRequested DataAccessGrant[] @relation("DataAccessRequestedBy")
  dataAccessDecided   DataAccessGrant[] @relation("DataAccessDecidedBy")
  entryComments   EntryComment[]   @relation("EntryCommentAuthor")
  recordRevisions RecordRevision[] @relation("RecordRevisionEditedBy")
  tasksAssigned   AssignedTask[]   @relation("TaskAssignee")
  tasksCreated    AssignedTask[]   @relation("TaskCreator")

  @@index([role])
  @@index([canManageQuestionnaire])
}

/// A documentation task assigned by an admin/master admin to a user, so field work is
/// planned and tracked. Status is a plain String (OPEN | IN_PROGRESS | DONE | CANCELLED)
/// for client compatibility.
/// A documentation assignment: what somebody has been asked to record, and how far along they are.
///
/// One row is always ONE assignee, so progress and accountability stay per-person; assigning the
/// same work to five researchers writes five rows sharing a `batchId`. The scope columns describe
/// the work without naming a specific record, because the record usually does not exist yet — that
/// is the point of the task. A task can therefore say "record products and tools for these three
/// artisans in this workshop" or "answer questionnaire sections C and D for every artisan you have",
/// and `targetCount` turns either into a countable goal.
model AssignedTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("OPEN")
  dueAt       DateTime?
  completedAt DateTime?
  /// Legacy single-record link, kept so existing rows and the old create path keep working.
  recordType  String?
  recordId    String?
  /// The workshop this work belongs to. Everything a researcher does is workshop-scoped, so the
  /// assignment screen starts by picking one and every task it creates carries it.
  workshopId  String?
  workshop    Workshop? @relation("TaskWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)
  /// Which kinds of record to produce: artisan / product / process / tool / questionnaire / media.
  /// A list, so "record products AND tools" is one task rather than two.
  recordTypes String[]  @default([])
  /// Optional narrowing to specific artisans. Empty = every artisan in scope for the assignee.
  artisanIds  String[]  @default([])
  /// Questionnaire sections this person is responsible for. Empty = not a questionnaire task.
  sectionIds  String[]  @default([])
  /// How many records of the given types to produce. Null = "as many as apply".
  targetCount Int?
  /// Assignee-reported progress toward targetCount, so a partly-done task is visible as such.
  progressCount Int     @default(0)
  /// Shared by every row created in one assignment action, so the creator can see and manage the
  /// batch ("record tools for these 5 people") as a single unit.
  batchId     String?
  assigneeId  String
  assignee    User      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assigneeId, status])
  @@index([createdById])
  @@index([workshopId])
  @@index([batchId])
}

/// One piece of app feedback per user: a quantitative rating (1–5) plus a qualitative comment.
/// Upserted, so a user can revisit and update their feedback at any time. The master admin reviews
/// everyone's feedback on the View Data screen.
model Feedback {
  id        String   @id @default(cuid())
  userId    String   @unique
  // Quantitative (each 1–5). `rating` is the overall score; the rest are per-aspect sub-ratings.
  rating        Int?
  easeOfUse     Int?
  reliability   Int?
  performance   Int?
  design        Int?
  features      Int?
  recommend     Int?
  // Qualitative free text. `comment` is the general note; the rest are targeted prompts.
  comment         String?
  likeMost        String?
  improve         String?
  bugs            String?
  featureRequests String?
  role            String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("FeedbackUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

/// One row per user holding their appearance + accessibility choices, upserted exactly like
/// Feedback so a user can flip a switch on any device and have it follow their account. `theme`
/// is a plain String (system | light | dark) rather than an enum, matching the client contract and
/// keeping future options additive.
model UserPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  theme         String   @default("system")
  reducedMotion Boolean  @default(false)
  largerText    Boolean  @default(false)
  highContrast  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation("UserPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)
}

/// A published Android app build that the master admin pushed out as an over-the-air update. The
/// highest versionCode is the current release; clients compare their installed versionCode and
/// self-update from `url`.
model AppRelease {
  id            String   @id @default(cuid())
  versionCode   Int
  versionName   String
  objectKey     String
  url           String?
  notes         String?
  publishedById String?
  publishedBy   User?    @relation("AppReleasePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime @default(now())

  @@index([versionCode])
}

model Craft {
  id            String   @id @default(cuid())
  name          String   @unique
  localName     String?
  category      String?
  description   String?
  place         String?
  extraMetadata Json?
  recordedAt    DateTime @default(now())
  recordedTimezone String @default("Asia/Kolkata")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  /// The workshop this craft was documented at, named EXPLICITLY on the record. Additive to the
  /// WorkshopCraft join (which every existing query reads through and which is kept in lock-step);
  /// nullable, so every row recorded before this column keeps behaving exactly as before.
  workshopId    String?

  createdBy User?                  @relation("CraftCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  workshop  Workshop?              @relation("CraftWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)
  artisans  Artisan[]
  products  ProductDocumentation[]
  tools     ToolDocumentation[]
  media     MediaFile[]
  workshops WorkshopCraft[]

  @@index([name])
  @@index([place])
  @@index([workshopId])
  @@index([recordedAt])
}

model Location {
  id            String   @id @default(cuid())
  latitude      Float
  longitude     Float
  altitude      Float?
  accuracy      Float?
  address       String?
  placeName     String?
  /// Postal state or union territory, stored as the canonical name from the closed list in
  /// services/address.py — which api/routes/reference.py also SERVES, so a form's dropdown and the
  /// validator can never hold different lists. Free text here would split one state across four
  /// spellings in every group-by and export, the way craft names did before title-casing.
  state         String?
  /// Indian PIN code as the bare 6 digits ("380001"). Validated as exactly six ASCII digits with a
  /// leading 1–9: the first digit is the postal zone and there is no zone 0.
  pincode       String?
  capturedAt    DateTime?
  extraMetadata Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  artisans  Artisan[]
  workshops Workshop[]
  products  ProductDocumentation[]
  tools     ToolDocumentation[]
  media     MediaFile[]
  questionnaireInterviews QuestionnaireInterview[]

  @@index([latitude, longitude])
  @@index([placeName])
  /// "Every record in Gujarat" is the query this column exists to make possible; without the index
  /// it is a sequential scan of every location ever captured.
  @@index([state])
}

model Artisan {
  id            String       @id @default(cuid())
  name          String
  localName     String?
  gender        String?
  phone         String?
  email         String?
  place         String
  /// The artisan's Aadhaar number, stored as the bare 12 digits. This is the DEDUPLICATION KEY:
  /// the same person documented at two workshops by two researchers must collapse to one record,
  /// and this unique index is what enforces it. Validated (12 digits, leading 2–9, Verhoeff
  /// checksum) in services/artisan_identity.py, and MASKED to "XXXX XXXX 9012" on every exported or
  /// shared surface.
  ///
  /// REQUIRED to create an artisan, and enforced by ArtisanCreate rather than by NOT NULL. The
  /// column stays nullable on purpose: production holds artisans recorded before this field existed,
  /// and the only ways to satisfy a NOT NULL would be to invent numbers for them (fabricating a
  /// national ID, which would also collide with this very unique index) or to delete them. Both are
  /// unacceptable, so those rows keep NULL — readable, editable, and exempt from the unique index,
  /// since Postgres permits any number of NULLs under one. Same pattern as dos/donts above.
  aadhaarNumber String?      @unique
  /// Does this artisan hold an Artisan Pehchan Card (the PM Vishwakarma ID)? Defaults to true,
  /// matching the form's default answer.
  pehchanCardAvailable Boolean @default(true)
  /// The Pehchan card number, normalised to uppercase alphanumerics. Required exactly when
  /// pehchanCardAvailable is true, and force-cleared to NULL when it is false, so a card number can
  /// never be orphaned on a record that says it has no card.
  pehchanCardNumber String?  @unique
  address       String?
  notes         String?
  // Newline-separated, numbered guidance for working with this artisan: dos = positive prompt (what to
  // do / emphasise), donts = negative prompt (what to avoid). Required on new records; nullable so the
  // existing rows from before this field can be backfilled later instead of blocking the migration.
  dos           String?
  donts         String?
  status        RecordStatus @default(PENDING)
  reviewNotes   String?
  reviewedById  String?
  reviewedAt    DateTime?
  extraMetadata Json?
  recordedAt    DateTime     @default(now())
  recordedTimezone String    @default("Asia/Kolkata")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  craftId       String?
  locationId    String?
  createdById   String
  /// The workshop this artisan was documented at, named EXPLICITLY on the record. Additive to the
  /// WorkshopArtisan join (which every existing query reads through and which is kept in lock-step);
  /// nullable, so every row recorded before this column keeps behaving exactly as before.
  workshopId    String?

  craft     Craft?                 @relation(fields: [craftId], references: [id], onDelete: SetNull)
  location  Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy User                   @relation("ArtisanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  workshop  Workshop?              @relation("ArtisanWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)
  workshops WorkshopArtisan[]
  products  ProductDocumentation[]
  tools     ToolDocumentation[]
  toolLinks ToolArtisan[]
  media     MediaFile[]
  questionnaireInterviews QuestionnaireInterviewArtisan[]
  sectionStatuses QuestionnaireSectionStatus[]

  @@index([name])
  @@index([place])
  @@index([craftId])
  @@index([createdById])
  @@index([workshopId])
  @@index([status])
  @@index([recordedAt])
}

model Workshop {
  id            String       @id @default(cuid())
  title         String
  date          DateTime
  startDate     DateTime?
  endDate       DateTime?
  place         String
  description   String?
  notes         String?
  status        RecordStatus @default(PENDING)
  reviewNotes   String?
  reviewedById  String?
  reviewedAt    DateTime?
  extraMetadata Json?
  recordedAt    DateTime     @default(now())
  recordedTimezone String    @default("Asia/Kolkata")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  locationId    String?
  createdById   String

  location  Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy User                   @relation("WorkshopCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  artisans  WorkshopArtisan[]
  crafts    WorkshopCraft[]
  products  ProductDocumentation[]
  tools     ToolDocumentation[]
  media     MediaFile[]
  assignments WorkshopAssignment[] @relation("WorkshopAssignments")
  tasks       AssignedTask[]       @relation("TaskWorkshop")
  // Back-relations for the EXPLICIT workshopId column on the remaining record types. `artisans` /
  // `crafts` above are the join-table links; these are the direct ones, kept in lock-step for
  // artisans and crafts so both readings of "who was at this workshop" agree.
  artisansLinked          Artisan[]                @relation("ArtisanWorkshop")
  craftsLinked            Craft[]                  @relation("CraftWorkshop")
  processes               Process[]                @relation("ProcessWorkshop")
  questionnaireInterviews QuestionnaireInterview[] @relation("InterviewWorkshop")

  @@index([date])
  @@index([startDate])
  @@index([endDate])
  @@index([place])
  @@index([createdById])
  @@index([status])
  @@index([recordedAt])
}

model WorkshopArtisan {
  workshopId String
  artisanId  String
  role       String?
  createdAt  DateTime @default(now())

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  artisan  Artisan  @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@id([workshopId, artisanId])
  @@index([artisanId])
}

model WorkshopCraft {
  workshopId String
  craftId    String
  createdAt  DateTime @default(now())

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  craft    Craft    @relation(fields: [craftId], references: [id], onDelete: Cascade)

  @@id([workshopId, craftId])
  @@index([craftId])
}

model ProductDocumentation {
  id                         String       @id @default(cuid())
  craftName                  String
  place                      String
  artisanName                String
  productName                String
  localName                  String?
  productType                ProductType  @default(OTHER)
  timeTakenToCompleteProduct String?
  size                       String?
  lengthInches               Decimal?     @db.Decimal(10, 2)
  breadthInches              Decimal?     @db.Decimal(10, 2)
  heightInches               Decimal?     @db.Decimal(10, 2)
  measurementImageId         String?
  measurementAnalysis        Json?
  measurementAnalysisStatus  String?
  costOfMaking               Decimal?     @db.Decimal(12, 2)
  sellingPrice               Decimal?     @db.Decimal(12, 2)
  marketDemand               MarketDemand @default(UNKNOWN)
  rawMaterialsUsed           String?
  mainToolsUsed              String?
  productFunctionUse         String?
  remarks                    String?
  status                     RecordStatus @default(PENDING)
  reviewNotes                String?
  reviewedById               String?
  reviewedAt                 DateTime?
  extraMetadata              Json?
  recordedAt                 DateTime     @default(now())
  recordedTimezone           String       @default("Asia/Kolkata")
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  artisanId                  String?
  craftId                    String?
  workshopId                 String?
  locationId                 String?
  createdById                String

  artisan   Artisan?    @relation(fields: [artisanId], references: [id], onDelete: SetNull)
  craft     Craft?      @relation(fields: [craftId], references: [id], onDelete: SetNull)
  workshop  Workshop?   @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  location  Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy User        @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  media     MediaFile[]
  mediaProcessingJobs MediaProcessingJob[]
  processes Process[]

  @@index([productName])
  @@index([craftName])
  @@index([place])
  @@index([artisanName])
  @@index([artisanId])
  @@index([craftId])
  @@index([workshopId])
  @@index([createdById])
  @@index([status])
  @@index([recordedAt])
}

model ToolDocumentation {
  id                            String        @id @default(cuid())
  craftName                     String
  place                         String
  artisanName                   String
  toolkitName                   String
  localName                     String?
  englishName                   String?
  processUsedIn                 String?
  material                      String?
  yearsInUse                    Int?
  height                        Decimal?      @db.Decimal(10, 2)
  width                         Decimal?      @db.Decimal(10, 2)
  lengthInches                  Decimal?      @db.Decimal(10, 2)
  breadthInches                 Decimal?      @db.Decimal(10, 2)
  measurementImageId            String?
  measurementAnalysis           Json?
  measurementAnalysisStatus     String?
  thickness                     Decimal?      @db.Decimal(10, 2)
  weight                        Decimal?      @db.Decimal(10, 2)
  radius                        Decimal?      @db.Decimal(10, 2)
  maker                         MakerType     @default(UNKNOWN)
  traditionType                 TraditionType @default(UNKNOWN)
  replacementCost               Decimal?      @db.Decimal(12, 2)
  suggestionsForToolImprovement String?
  remarks                       String?
  status                        RecordStatus  @default(PENDING)
  reviewNotes                   String?
  reviewedById                  String?
  reviewedAt                    DateTime?
  extraMetadata                 Json?
  recordedAt                    DateTime      @default(now())
  recordedTimezone              String        @default("Asia/Kolkata")
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt
  artisanId                     String?
  craftId                       String?
  workshopId                    String?
  locationId                    String?
  createdById                   String

  artisan   Artisan?    @relation(fields: [artisanId], references: [id], onDelete: SetNull)
  craft     Craft?      @relation(fields: [craftId], references: [id], onDelete: SetNull)
  workshop  Workshop?   @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  location  Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy User        @relation("ToolCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  media     MediaFile[]
  mediaProcessingJobs MediaProcessingJob[]
  artisanLinks ToolArtisan[]

  @@index([toolkitName])
  @@index([craftName])
  @@index([place])
  @@index([artisanName])
  @@index([artisanId])
  @@index([craftId])
  @@index([workshopId])
  @@index([createdById])
  @@index([status])
  @@index([recordedAt])
}

// Many-to-many between a tool and the artisans who use it. Lets one documented tool be assigned to
// several artisans (across the same or different crafts) instead of re-entering the tool per craft.
model ToolArtisan {
  id        String   @id @default(cuid())
  toolId    String
  artisanId String
  createdAt DateTime @default(now())

  tool    ToolDocumentation @relation(fields: [toolId], references: [id], onDelete: Cascade)
  artisan Artisan           @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@unique([toolId, artisanId])
  @@index([toolId])
  @@index([artisanId])
}

model MediaFile {
  id               String       @id @default(cuid())
  originalFilename String
  mediaType        MediaType
  mimeType         String
  sizeBytes        BigInt
  bucket           String
  objectKey        String       @unique
  url              String?
  caption          String?
  checksum         String?
  transcriptText   String?
  transcriptSummary String?
  transcriptStatus String?
  transcriptError  String?
  linkedRecordType String?
  linkedRecordId   String?
  status           RecordStatus @default(PENDING)
  reviewNotes      String?
  reviewedById     String?
  reviewedAt       DateTime?
  extraMetadata    Json?
  recordedAt       DateTime     @default(now())
  recordedTimezone String       @default("Asia/Kolkata")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  uploadedById     String
  artisanId        String?
  craftId          String?
  workshopId       String?
  productId        String?
  toolId           String?
  questionnaireInterviewId String?
  locationId       String?

  uploadedBy User                  @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  artisan    Artisan?              @relation(fields: [artisanId], references: [id], onDelete: SetNull)
  craft      Craft?                @relation(fields: [craftId], references: [id], onDelete: SetNull)
  workshop   Workshop?             @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  product    ProductDocumentation? @relation(fields: [productId], references: [id], onDelete: SetNull)
  tool       ToolDocumentation?    @relation(fields: [toolId], references: [id], onDelete: SetNull)
  questionnaireInterview QuestionnaireInterview? @relation("QuestionnaireMedia", fields: [questionnaireInterviewId], references: [id], onDelete: SetNull)
  location   Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  processingJobs MediaProcessingJob[]

  @@index([mediaType])
  @@index([uploadedById])
  @@index([craftId])
  @@index([linkedRecordType, linkedRecordId])
  @@index([questionnaireInterviewId])
  @@index([createdAt])
  @@index([status])
  @@index([recordedAt])
}

model MediaProcessingJob {
  id             String                   @id @default(cuid())
  jobType        MediaProcessingJobType
  status         MediaProcessingJobStatus @default(QUEUED)
  priority       Int                      @default(100)
  attempts       Int                      @default(0)
  maxAttempts    Int                      @default(3)
  error          String?
  result         Json?
  lockedAt       DateTime?
  lockedBy       String?
  runAfter       DateTime                 @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  mediaFileId    String
  requestedById  String?
  productId      String?
  toolId         String?

  mediaFile   MediaFile              @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  requestedBy User?                  @relation("MediaProcessingRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  product     ProductDocumentation?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  tool        ToolDocumentation?     @relation(fields: [toolId], references: [id], onDelete: SetNull)

  @@index([status, runAfter, priority, createdAt])
  @@index([mediaFileId])
  @@index([requestedById])
  @@index([productId])
  @@index([toolId])
}

model QuestionnaireSection {
  id        String   @id @default(cuid())
  code      String   @unique
  title     String
  sortOrder Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions QuestionnaireQuestion[]
  sectionStatuses QuestionnaireSectionStatus[]

  @@unique([sortOrder])
  @@index([code])
  @@index([isActive, sortOrder])
}

/// Admin-set completion status for one (artisan, section) cell on the "Check completion" matrix.
/// Absent row = no manual override (the matrix then falls back to data-derived completion). A row
/// here is an explicit verdict by an admin/master admin that overrides the derived green.
model QuestionnaireSectionStatus {
  id        String   @id @default(cuid())
  artisanId String
  sectionId String
  // COMPLETED (green) | NEEDS_REVIEW (yellow) | NEEDS_REDO (red).
  status    String
  setById   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artisan Artisan              @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  section QuestionnaireSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  setBy   User                 @relation("SectionStatusSetBy", fields: [setById], references: [id], onDelete: Restrict)

  @@unique([artisanId, sectionId])
  @@index([artisanId])
  @@index([sectionId])
}

model QuestionnaireQuestion {
  id          String   @id @default(cuid())
  sectionCode String
  sectionTitle String
  prompt      String
  sortOrder   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sectionId   String?

  section   QuestionnaireSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  responses QuestionnaireResponse[]

  @@index([sectionCode])
  @@index([sectionId])
  @@index([isActive])
}

model QuestionnaireInterview {
  id            String       @id @default(cuid())
  title         String
  interviewDate DateTime?
  place         String?
  language      String?
  notes         String?
  status        RecordStatus @default(PENDING)
  /// Review audit, identical to every other reviewable record. These were MISSING here while
  /// Artisan/Workshop/Product/Tool/Process/Media all had them, so the moment interviews became
  /// reviewable every approve raised
  ///   FieldNotFoundError: Could not find field at `updateOneQuestionnaireInterview.data.reviewNotes`
  /// which escaped as a bare 500 ("Failed to fetch" in the browser, HTTP 500 on Android).
  reviewNotes   String?
  reviewedById  String?
  reviewedAt    DateTime?
  extraMetadata Json?
  recordedAt    DateTime     @default(now())
  recordedTimezone String    @default("Asia/Kolkata")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdById   String
  locationId    String?
  // Deterministic key for the exact set of artisans this interview covers (sorted, comma-joined
  // artisan ids). Enforces ONE interview per artisan set: creation is idempotent on this key, so
  // every client lands on the single canonical entry instead of spawning duplicates. NULL only when
  // an interview has no artisans (those are not deduped). A subset is a different set => different key.
  artisanSetKey String?      @unique
  /// The workshop this interview was conducted at, named EXPLICITLY on the record — previously an
  /// interview had no path to a workshop at all. Nullable, so every interview recorded before this
  /// column keeps behaving exactly as before.
  workshopId    String?

  createdBy User                             @relation("QuestionnaireCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  location  Location?                        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  workshop  Workshop?                        @relation("InterviewWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)
  artisans  QuestionnaireInterviewArtisan[]
  responses QuestionnaireResponse[]
  media     MediaFile[]                      @relation("QuestionnaireMedia")

  @@index([createdById])
  @@index([workshopId])
  @@index([status])
  @@index([interviewDate])
  @@index([recordedAt])
}

model QuestionnaireInterviewArtisan {
  interviewId String
  artisanId   String
  createdAt   DateTime @default(now())

  interview QuestionnaireInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  artisan   Artisan                @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@id([interviewId, artisanId])
  @@index([artisanId])
}

model QuestionnaireResponse {
  id          String   @id @default(cuid())
  interviewId String
  questionId  String
  answerText  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  answeredById String

  interview  QuestionnaireInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question   QuestionnaireQuestion  @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answeredBy User                   @relation("QuestionnaireAnsweredBy", fields: [answeredById], references: [id], onDelete: Restrict)

  @@unique([interviewId, questionId])
  @@index([questionId])
  @@index([answeredById])
}

model Process {
  id                  String       @id @default(cuid())
  name                String
  preProcessAvailable Boolean      @default(false)
  notes               String?
  status              RecordStatus @default(PENDING)
  reviewNotes         String?
  reviewedById        String?
  reviewedAt          DateTime?
  extraMetadata       Json?
  recordedAt          DateTime     @default(now())
  recordedTimezone    String       @default("Asia/Kolkata")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  productId           String
  createdById         String
  /// The workshop this process was documented at, named EXPLICITLY on the record. A process used to
  /// reach a workshop only through its parent product; both readings still work, and this column is
  /// nullable so every row recorded before it keeps behaving exactly as before.
  workshopId          String?

  product   ProductDocumentation @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("ProcessCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  workshop  Workshop?            @relation("ProcessWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)
  steps     ProcessStep[]

  @@index([productId])
  @@index([createdById])
  @@index([workshopId])
  @@index([status])
  @@index([recordedAt])
}

model ProcessStep {
  id        String          @id @default(cuid())
  processId String
  name      String
  stepType  ProcessStepType @default(SEQUENTIAL)
  sortOrder Int
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
}

model ReviewLog {
  id         String           @id @default(cuid())
  recordType ReviewRecordType
  recordId   String
  status     RecordStatus
  notes      String?
  reviewerId String
  createdAt  DateTime         @default(now())

  reviewer User @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([recordType, recordId])
  @@index([reviewerId])
  @@index([createdAt])
}

// Singleton row (id = "singleton") holding master-admin-configurable global settings. For now: how
// audio transcripts are produced (raw / refined / refined+translated) and an optional off-peak window
// during which the heavy transcription+refinement work runs, so it doesn't compete with daytime
// uploads. Extend with more configurable fields over time.
model AppSetting {
  id                 String   @id @default("singleton")
  transcriptionMode  String   @default("REFINED_TRANSLATED")
  /// Speech-to-text providers in the order the master admin ranked them. One with no configured key
  /// is skipped where it sits, so this ranks preference and never gates transcription.
  sttProviderOrder   String[] @default(["elevenlabs", "deepgram", "whisper"])
  batchWindowEnabled Boolean  @default(false)
  batchWindowStart   String   @default("02:00")
  batchWindowEnd     String   @default("05:00")
  batchTimezone      String   @default("Asia/Kolkata")
  updatedAt          DateTime @updatedAt
  updatedById        String?
}

/// A workshop-to-researcher assignment made by an admin. Only researchers assigned to a workshop may
/// create records tied to it, and a submission made outside the workshop's [startDate, endDate] window
/// is flagged as needing admin approval. A workshop with NO assignment rows is open to everyone
/// (backward compatible with data created before assignments existed).
/// Who may work in a workshop, and at what level.
///
/// One row covers BOTH directions of the same relationship, because they settle into the same
/// state: an admin granting access to somebody, and a newly-onboarded user asking for it. The
/// difference is only where the row starts — an admin's grant begins GRANTED, a self-request begins
/// PENDING and needs an admin decision — so a single table means the grant list and the request
/// queue can never disagree about who currently has access.
model WorkshopAssignment {
  id           String   @id @default(cuid())
  workshopId   String
  userId       String
  assignedById String?
  /// VIEW (read the workshop's data), CONTRIBUTE (add records), EDIT (change anyone's records here).
  /// Ordered, so a check is a rank comparison rather than a set membership test.
  accessLevel  String   @default("CONTRIBUTE")
  /// PENDING (requested, awaiting an admin) / GRANTED / DENIED / REVOKED. Only GRANTED confers
  /// access; DENIED and REVOKED are kept rather than deleted so the decision stays auditable and a
  /// user cannot silently re-request their way around a refusal.
  status       String   @default("GRANTED")
  /// Set when the row began as the user's own request, so the queue can tell the two apart.
  requestedById String?
  requestNote  String?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workshop    Workshop @relation("WorkshopAssignments", fields: [workshopId], references: [id], onDelete: Cascade)
  user        User     @relation("WorkshopAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy  User?    @relation("WorkshopAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  requestedBy User?    @relation("WorkshopAssignmentRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?    @relation("WorkshopAssignmentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([workshopId, userId])
  @@index([userId])
  @@index([workshopId])
  @@index([status])
}

/// A runtime-editable API key or service credential.
///
/// Keys used to live only in the EC2 `.env`, so rotating one meant an SSH session and a restart —
/// and nobody but the person holding the server could see whether a provider was even configured.
/// A master admin can now read (redacted), set and rotate them from the Settings hub, and the
/// services read through `services/managed_secrets.py`, which prefers a stored value and falls back
/// to the environment. That fallback is what makes this safe to deploy: an empty table behaves
/// exactly like today.
///
/// `value` is encrypted at rest with Fernet (see managed_secrets.py) rather than stored in the
/// clear, because a database dump of provider keys is a far worse leak than a config file on one
/// box. It is NEVER returned to a client in full — only a masked preview plus a reachability check.
model ManagedSecret {
  id          String   @id @default(cuid())
  /// The environment-variable name this overrides, e.g. "OPENAI_API_KEY".
  key         String   @unique
  /// Fernet ciphertext. Never logged, never serialised to a response.
  valueEnc    String
  /// Last four characters of the plaintext, so the UI can show "…a4f2" without decrypting.
  hint        String?
  description String?
  /// Result of the most recent reachability probe: UNKNOWN / OK / FAILED.
  lastStatus  String   @default("UNKNOWN")
  lastCheckedAt DateTime?
  lastError   String?
  updatedById String?
  updatedBy   User?    @relation("ManagedSecretUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

/// Tiered data-access sharing between researchers. OWNER = the author whose uploaded records are being
/// shared; GRANTEE = the researcher who receives access at `tier` (DOWNLOAD < COMMENT < EDIT). Exactly
/// one row per (owner, grantee) pair: status PENDING is an outstanding request raised by the grantee;
/// GRANTED is active. `allData` true covers everything the owner uploaded; otherwise the covered set is
/// the explicit `scopeItems` subset.
model DataAccessGrant {
  id            String           @id @default(cuid())
  ownerId       String
  granteeId     String
  tier          DataAccessTier   @default(DOWNLOAD)
  status        DataAccessStatus @default(PENDING)
  allData       Boolean          @default(true)
  requestNote   String?
  decisionNote  String?
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  owner       User  @relation("DataAccessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  grantee     User  @relation("DataAccessGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  requestedBy User? @relation("DataAccessRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User? @relation("DataAccessDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  scopeItems  DataAccessScopeItem[]

  @@unique([ownerId, granteeId])
  @@index([granteeId])
  @@index([ownerId])
  @@index([status])
}

/// One record in the subset covered by a non-allData DataAccessGrant.
model DataAccessScopeItem {
  id         String   @id @default(cuid())
  grantId    String
  recordType String
  recordId   String
  createdAt  DateTime @default(now())

  grant DataAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@unique([grantId, recordType, recordId])
  @@index([grantId])
}

/// A comment on any record (generic over recordType/recordId), left by the record owner, an admin, or a
/// user holding COMMENT-tier-or-higher data access to the owner.
model EntryComment {
  id         String   @id @default(cuid())
  recordType String
  recordId   String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User @relation("EntryCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([recordType, recordId])
  @@index([authorId])
}

/// An immutable audit row capturing one edit to a record's fields. `changes` is a JSON object shaped
/// {field: {old, new}}. Recorded whenever a record's fields change through the contribute path so an
/// admin can reconstruct the original values alongside every subsequent edit and see who made each one.
model RecordRevision {
  id         String   @id @default(cuid())
  recordType String
  recordId   String
  editedById String?
  changes    Json
  createdAt  DateTime @default(now())

  editedBy User? @relation("RecordRevisionEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([recordType, recordId])
  @@index([editedById])
}
