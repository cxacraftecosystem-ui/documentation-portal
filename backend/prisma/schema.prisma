model ToolDocumentation {
  id                            String        @id @default(cuid())
  craftName                     String
  place                         String
  artisanName                   String
  toolkitName                   String
  localName                     String?
  englishName                   String?
  processUsedIn                 String?
  material                      String?
  yearsInUse                    Int?
  height                        Decimal?      @db.Decimal(10, 2)
  width                         Decimal?      @db.Decimal(10, 2)
  lengthInches                  Decimal?      @db.Decimal(10, 2)
  breadthInches                 Decimal?      @db.Decimal(10, 2)
  /// The THIRD of the triple. `ProductDocumentation` has carried all three since it was written;
  /// this table stopped at two, and the omission was not harmless: the grid-measurement panel
  /// returns an INCHES reading (`GridMeasurement.tsx` reads `analysis.valueInches`) and both clients
  /// handed it to the plain `height` column above — a column that DECLARES NO UNIT — losing the one
  /// fact the column name is there to carry. The product form, two files away, wrote the same
  /// reading into `heightInches` all along.
  ///
  /// `height` above is a DIFFERENT COLUMN and is not being merged into this one: rows already hold
  /// values in it and nothing in the database can say what unit those are in. See migration
  /// 20260913120100.
  ///
  /// SINCE 2026-09-15 THE TWO ARE TWO UNITS OF ONE MEASUREMENT ON EVERY CLIENT, and that is a change
  /// to what NEW rows mean, not a claim about old ones. `height` is the centimetre box ("Height
  /// (cm)"), this is the inch box, and typing in either fills the other at 2.54 cm to the inch;
  /// `width` and `breadthInches` pair the same way, and `lengthInches` has no centimetre partner.
  /// No conversion happens on LOAD and none happened in a migration, so a row saved before the
  /// pairing keeps both of its numbers exactly as they were — including the ones that disagree.
  heightInches                  Decimal?      @db.Decimal(10, 2)
  measurementImageId            String?
  measurementAnalysis           Json?
  measurementAnalysisStatus     String?
  thickness                     Decimal?      @db.Decimal(10, 2)
  weight                        Decimal?      @db.Decimal(10, 2)
  radius                        Decimal?      @db.Decimal(10, 2)
  maker                         MakerType     @default(UNKNOWN)
  traditionType                 TraditionType @default(UNKNOWN)
  replacementCost               Decimal?      @db.Decimal(12, 2)
  suggestionsForToolImprovement String?
  remarks                       String?
  status                        RecordStatus  @default(PENDING)
  reviewNotes                   String?
  reviewedById                  String?
  reviewedAt                    DateTime?
  extraMetadata                 Json?
  recordedAt                    DateTime      @default(now())
  recordedTimezone              String        @default("Asia/Kolkata")
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt
  artisanId                     String?
  craftId                       String?
  workshopId                    String?
  locationId                    String?
  createdById                   String
  /// The idempotency key of the create this row came from. See `Workshop.clientKey`.
  clientKey                     String?       @unique

  artisan   Artisan?    @relation(fields: [artisanId], references: [id], onDelete: SetNull)
  craft     Craft?      @relation(fields: [craftId], references: [id], onDelete: SetNull)
  workshop  Workshop?   @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  location  Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy User        @relation("ToolCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  media     MediaFile[]
  mediaProcessingJobs MediaProcessingJob[]
  artisanLinks ToolArtisan[]
  /// EVERY craft this tool is linked to. `craftId` above holds the FIRST of them and `craftName`
  /// holds all of their names joined ", " in the same order; this is the list itself. See
  /// `model ToolCraft` for why the column was kept rather than retired.
  craftLinks   ToolCraft[]

  @@index([artisanId])
  @@index([craftId])
  @@index([createdById])
  @@index([status])
  @@index([workshopId, createdAt])
  @@index([createdAt])
}

// Many-to-many between a tool and the artisans who use it. Lets one documented tool be assigned to
// several artisans (across the same or different crafts) instead of re-entering the tool per craft.
model ToolArtisan {
  id        String   @id @default(cuid())
  toolId    String
  artisanId String
  createdAt DateTime @default(now())

  tool    ToolDocumentation @relation(fields: [toolId], references: [id], onDelete: Cascade)
  artisan Artisan           @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  // No [toolId] of its own — it is the leading column of the unique below, which serves the
  // tool-to-artisans lookup already.
  @@unique([toolId, artisanId])
  @@index([artisanId])
}

// Many-to-many between a tool and the crafts it is linked to. Lets one documented tool cover several
// crafts instead of one, WITHOUT retiring `ToolDocumentation.craftId` — every existing filter, index,
// report, carry-forward and data-browser branch reads that column and keeps reading it. It holds the
// first of the selected crafts; this table holds all of them, and `craftName` holds their names
// joined ", " in the same order.
//
// IT MIRRORS `ToolArtisan` ABOVE COLUMN FOR COLUMN, deliberately: same four columns, same unique,
// same single secondary index, same CASCADE on both sides. See migration 20260915100000.
//
// THE ASYMMETRY WITH `ToolDocumentation.craft` IS THE EXISTING ONE AND IS NOT A DEFECT TO "FIX".
// That relation is `onDelete: SetNull` while this one is `onDelete: Cascade`, so deleting a `Craft`
// nulls `tool.craftId`, deletes the link row, and leaves `tool.craftName` holding the old joined
// string. `ToolArtisan` has had exactly that shape since it was written (`artisanId` SetNull, the
// link Cascade), which is why `artisanName` is NOT NULL — the name outlives the reference on
// purpose, so a record does not lose the only readable trace of who or what it documented.
model ToolCraft {
  id        String   @id @default(cuid())
  toolId    String
  craftId   String
  createdAt DateTime @default(now())

  tool  ToolDocumentation @relation(fields: [toolId], references: [id], onDelete: Cascade)
  craft Craft             @relation(fields: [craftId], references: [id], onDelete: Cascade)

  // No [toolId] of its own — it is the leading column of the unique below, which serves the
  // tool-to-crafts lookup already.
  @@unique([toolId, craftId])
  @@index([craftId])
}

model MediaFile {
  id               String       @id @default(cuid())
  originalFilename String
  mediaType        MediaType
  mimeType         String
  sizeBytes        BigInt
  bucket           String
  objectKey        String       @unique
  url              String?
  caption          String?
  checksum         String?
  transcriptText   String?
  transcriptSummary String?
  transcriptStatus String?
  transcriptError  String?
  /// Whether the transcript above is still the machine's words, and who changed them if not.
  ///
  /// `transcriptEditedAt` IS THE FLAG, and NULL on it means "not stated" rather than "never
  /// edited" — `POST /media/{id}/transcript` has been able to replace a transcript since long
  /// before these columns existed, so rows written before 20260913120200 genuinely do not say. Both
  /// clients render three states because of that: edited, not edited, and silent. Backfilling a
  /// `false` would have printed "the machine said this" over text a researcher typed, which is the
  /// single assertion the flag was asked for in order to stop making silently — and so would
  /// `edited={!!media.transcriptEditedAt}` on the reading end.
  ///
  /// `transcriptEditedById` carries NO relation, exactly as `reviewedById` below carries none: this
  /// is an audit stamp rather than a navigable edge, and a foreign key would force `onDelete` to
  /// answer whether removing an account may rewrite a transcript's provenance into "nobody edited
  /// this". It may not. See the migration for the rest of the argument, including why
  /// `services/media_queue` must never clear the flag.
  transcriptEditedAt DateTime?
  transcriptEditedById String?
  linkedRecordType String?
  linkedRecordId   String?
  status           RecordStatus @default(PENDING)
  reviewNotes      String?
  reviewedById     String?
  reviewedAt       DateTime?
  extraMetadata    Json?
  recordedAt       DateTime     @default(now())
  recordedTimezone String       @default("Asia/Kolkata")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  uploadedById     String
  artisanId        String?
  craftId          String?
  workshopId       String?
  productId        String?
  toolId           String?
  questionnaireInterviewId String?
  locationId       String?

  uploadedBy User                  @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  artisan    Artisan?              @relation(fields: [artisanId], references: [id], onDelete: SetNull)
  craft      Craft?                @relation(fields: [craftId], references: [id], onDelete: SetNull)
  workshop   Workshop?             @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  product    ProductDocumentation? @relation(fields: [productId], references: [id], onDelete: SetNull)
  tool       ToolDocumentation?    @relation(fields: [toolId], references: [id], onDelete: SetNull)
  questionnaireInterview QuestionnaireInterview? @relation("QuestionnaireMedia", fields: [questionnaireInterviewId], references: [id], onDelete: SetNull)
  location   Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  processingJobs MediaProcessingJob[]

  @@index([mediaType])
  @@index([uploadedById])
  @@index([linkedRecordType, linkedRecordId])
  @@index([createdAt])
  @@index([status])
  // The parent foreign keys. These are not for `where` clauses a route writes by hand — they are for
  // the reverse walk `include: {media: true}` generates, which Prisma issues as a separate
  // `WHERE "<fk>" IN (…the page's 20 parents…)`. craftId and questionnaireInterviewId were indexed;
  // artisanId, productId and toolId were not, so the products and tools lists each sequentially
  // scanned the whole of the largest table in the database once per page.
  @@index([craftId])
  @@index([questionnaireInterviewId])
  @@index([artisanId])
  @@index([productId])
  @@index([toolId])
  // Composite rather than bare workshopId: a workshop's media is the one parent set big enough that
  // the data browser's `ORDER BY createdAt` over it is worth serving from the index too.
  @@index([workshopId, createdAt])
}

model MediaProcessingJob {
  id             String                   @id @default(cuid())
  jobType        MediaProcessingJobType
  status         MediaProcessingJobStatus @default(QUEUED)
  priority       Int                      @default(100)
  attempts       Int                      @default(0)
  maxAttempts    Int                      @default(3)
  error          String?
  result         Json?
  lockedAt       DateTime?
  lockedBy       String?
  runAfter       DateTime                 @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  mediaFileId    String
  requestedById  String?
  productId      String?
  toolId         String?

  mediaFile   MediaFile              @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  requestedBy User?                  @relation("MediaProcessingRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  product     ProductDocumentation?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  tool        ToolDocumentation?     @relation(fields: [toolId], references: [id], onDelete: SetNull)

  @@index([status, runAfter, priority, createdAt])
  @@index([mediaFileId])
  @@index([requestedById])
  @@index([productId])
  @@index([toolId])
}

/// ONE NAMED INSTRUMENT. The parent this product did not have.
///
/// Until 2026-09-13 there was exactly ONE questionnaire, globally: `QuestionnaireSection` was the
/// top of the tree, its `code` was `@unique` across the whole database and its `sortOrder` was
/// `@@unique` across the whole database. That was correct while the institution ran one workshop
/// series with one instrument. It stopped being correct the moment a 3rd Craft Toolkit Workshop
/// arrived with 22 sections of its own coded A..V — because EVERY ONE of those codes is already
/// taken by the 2nd workshop's corpus (RESP, A..W), so seeding the new instrument against the old
/// uniques would not have created 22 sections. It would have RETITLED 22 live ones, silently
/// relabelling the questions and every answer hanging off them.
///
/// WHY A TABLE AND NOT A NULLABLE DISCRIMINATOR COLUMN. A nullable column cannot carry a real
/// unique index: Postgres treats NULLs as distinct, so `@@unique([instrument, code])` over a
/// nullable `instrument` permits unlimited duplicates on exactly the legacy rows that most need
/// protecting. The designer portal reached the same conclusion and recorded it —
/// see designer-portal schema.prisma:1727-1729, "the rejected nullable-questionnaireId design".
///
/// THERE IS NO DELETE, AND DELIBERATELY SO. Every child relation below is `onDelete: Restrict`.
/// An instrument is the parent of institutional fieldwork; the delete that looks convenient on a
/// list screen is the one that takes 284 questions and a year of answers with it. Retire with
/// `isActive = false`, which is what `DELETE /questionnaire/sections/{id}` already does one level
/// down (routes/questionnaire.py:396-403) and what the web confirm dialog already promises
/// ("Questions are deactivated, not erased" — frontend .../questionnaire/page.tsx).
model Questionnaire {
  id          String   @id @default(cuid())
  /// THE IDENTITY, and the key both seeders find their row by on a re-run — the same choice the
  /// designer's `seed_shared_questionnaire.py:80-86` makes and for the same reason ("an identity
  /// rather than a preference"). Unique HERE and not only in the script, because that script has
  /// no lock: two operators running it at once against a title-less key publish two standard forms
  /// and no client can tell which is current. The database refuses instead.
  title       String
  /// Prose for the picker ("81 questions across 22 sections, used from the 3rd workshop on").
  /// Carries no behaviour and is read by nothing but a human.
  description String?
  /// Retire without deleting. A retired instrument stops appearing in the picker and stops being
  /// bindable to a workshop; every interview already recorded against it keeps working unchanged.
  isActive    Boolean  @default(true)
  /// WHICH INSTRUMENT WHEN NOBODY SAID. Two callers need this and neither can be refused:
  ///   * an OLD Android build POSTing /questionnaire/interviews with no `questionnaireId` at all —
  ///     `ignoreUnknownKeys` means it will keep doing that for as long as handsets go unupdated;
  ///   * the capture page opened with no workshop chosen.
  /// Enforced as AT MOST ONE by a PARTIAL unique index in the migration, not by application code,
  /// because "only one row may be true" is precisely the rule two admins clicking at the same
  /// moment break. Prisma cannot express a partial unique index, so it is invisible here on
  /// purpose — see the migration, and the test that executes the migration to prove it exists
  /// (tests/test_questionnaire_instruments_migration.py).
  isDefault   Boolean  @default(false)
  /// Picker order. NOT unique, deliberately: two instruments sharing a position is a cosmetic tie,
  /// while a unique sortOrder is the exact constraint that forced `reorder_sections` into a
  /// negative-then-positive two-pass (routes/questionnaire.py:411-415). One such dance per schema
  /// is enough. Reads order by (sortOrder asc, createdAt asc).
  sortOrder   Int
  /// Provenance, like every other record (compare Workshop.createdById, schema.prisma:678).
  ///
  /// NULLABLE, which is the one place this column differs from every other `createdById` in the
  /// schema, and the reason is the migration rather than the product: the backfilled 2nd-workshop
  /// row is created by SQL that may run on a database with no accounts yet (a fresh `migrate
  /// deploy` happens BEFORE `seed_admin.py` — README.md:83-84). A NOT NULL here would make this
  /// migration's success depend on seed ORDER, which is the class of failure
  /// `20260725170000_repair_migration_history_drift` exists to record. Rows created through the
  /// API always carry a creator.
  createdById String?
  /// NOT A SCHEMA VERSION. The count of destructive-ish edits — a supersede or a retire — applied
  /// after the first answer existed, so a client holding a cached copy of the form can tell it is
  /// stale with an integer compare instead of a question diff. An ordinary edit (a reworded question
  /// nobody has answered, a reordered section) does NOT move it: the number means "an answer you are
  /// holding may now be attached to a wording that is no longer asked", not "something changed".
  version     Int      @default(1)
  /// The workbook this questionnaire was last uploaded from, so two spreadsheets a fortnight apart
  /// are tellable apart on the admin screen. Null for an instrument that was never uploaded — every
  /// one that exists today, since both seeders build theirs from JSON.
  sourceFilename String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy  User?                    @relation("QuestionnaireInstrumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sections   QuestionnaireSection[]
  questions  QuestionnaireQuestion[]
  interviews QuestionnaireInterview[]
  workshops  Workshop[]               @relation("WorkshopQuestionnaire")

  @@unique([title])
  @@index([isActive, sortOrder])
}

model QuestionnaireSection {
  id              String   @id @default(cuid())
  /// NOT NULL. Every section belongs to exactly one instrument; there is no such thing as a
  /// free-floating section, and a nullable column here would undo the composite uniques below.
  questionnaireId String
  code            String
  title           String
  sortOrder       Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Restrict, NOT Cascade — the opposite of the designer's equivalent (designer
  /// schema.prisma:1728), and the difference is what the two tables hold. A designer's draft form
  /// is disposable; this one holds a ministry's fieldwork. Cascade here would also fail HALFWAY,
  /// because QuestionnaireResponse.question is itself Restrict (schema.prisma below) — a delete
  /// would erase the sections, then abort on the first answered question, in a repo with no
  /// transaction idiom (zero `db.tx()` call sites). Refusing at the top is the only clean answer.
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Restrict)
  questions       QuestionnaireQuestion[]
  sectionStatuses QuestionnaireSectionStatus[]

  /// Codes are unique WITHIN an instrument and nowhere else. Two instruments both naming a section
  /// "A" is not a collision, it is the normal case — the 2nd workshop's A is "PERSONAL DETAILS OF
  /// THE ARTISAN" and the 3rd's is "ORIGIN, HISTORY, PLACE AND PERSONAL JOURNEY".
  @@unique([questionnaireId, code])
  /// Scoped for the same reason, and it is ALSO what makes the seeder safe: the fatal collision
  /// was the new section A claiming sortOrder 1 while RESP still held it globally.
  @@unique([questionnaireId, sortOrder])
  @@index([questionnaireId, isActive, sortOrder])
}

/// Admin-set completion status for one (artisan, section) cell on the "Check completion" matrix.
/// Absent row = no manual override (the matrix then falls back to data-derived completion). A row
/// here is an explicit verdict by an admin/master admin that overrides the derived green.
///
/// PER-INSTRUMENT BY CONSTRUCTION, since 2026-09-13. This table is keyed on (artisanId, sectionId)
/// and a sectionId now belongs to exactly one instrument, so an admin's override on the 2nd
/// workshop's section D cannot leak onto the 3rd workshop's section D. It remains repository-wide
/// ACROSS WORKSHOPS, which is what `overridesAreRepositoryWide: True` on the completion payload
/// says (routes/questionnaire.py) and which is still true.
///
/// `section` is ON DELETE CASCADE and this file is NOT the place that protects these rows — the
/// 34 admin verdicts on the live database are protected by QuestionnaireSection.questionnaire being
/// `Restrict`, one level up: nothing can delete a section without first deleting its instrument,
/// and nothing can delete an instrument at all.
model QuestionnaireSectionStatus {
  id        String   @id @default(cuid())
  artisanId String
  sectionId String
  // COMPLETED (green) | NEEDS_REVIEW (yellow) | NEEDS_REDO (red).
  status    String
  setById   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artisan Artisan              @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  section QuestionnaireSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  setBy   User                 @relation("SectionStatusSetBy", fields: [setById], references: [id], onDelete: Restrict)

  @@unique([artisanId, sectionId])
  @@index([sectionId])
}

/// ONE PROMPT. Answers are plain prose — there is no question TYPE column here and none is coming
/// in this change.
///
/// The 3rd-workshop instrument's section V ("NETWORK / ECOSYSTEM MAPPING — STRUCTURED FIELDS",
/// questions 76-81 by global position) asks for repeating lists: "List the designers you have
/// connected with, including name, place/organisation, nature of relationship and frequency of
/// interaction." Those ship as PROSE PROMPTS, on purpose, and this comment is the decision so
/// nobody re-opens it: a repeating-row answer needs a renderer on the web form, on Android, in the
/// consolidated document, in its CSV columns and in the completion derivation — five surfaces —
/// and the DEFAULT capture mode is one audio recording for the whole section with the answer boxes
/// hidden (frontend/components/forms/QuestionnaireCaptureControls.tsx:27), so a grid would be
/// invisible to most interviewers on day one. The prompts name their own fields, so a prose answer
/// is self-describing and can be structured later without being re-collected.
model QuestionnaireQuestion {
  id              String   @id @default(cuid())
  /// DENORMALISED FROM THE SECTION, and NOT NULL, for three reasons that are all about `sectionId`
  /// being nullable below: (1) a question whose section was hard-deleted would otherwise have no
  /// path to an instrument at all, while its answers survive under Restrict; (2)
  /// `_derived_completed_sections` read EVERY question with no `where` to build its map
  /// (routes/questionnaire.py) and needed a column to narrow on; (3) this table already
  /// denormalises its parent as `sectionCode`/`sectionTitle`, kept in lock-step by `update_section`
  /// (routes/questionnaire.py). One more parent key is the same pattern, with the same
  /// rule: NOTHING may move a question between instruments. `update_question` and
  /// `reorder_questions` both refuse it with a 422.
  questionnaireId String
  sectionCode     String
  sectionTitle    String
  prompt          String
  sortOrder       Int
  isActive        Boolean  @default(true)
  /// The "Help text" column of the .xlsx pro-forma. Optional: the parser reports a blank one as
  /// nothing at all, which is the ordinary case. Without this column the import would read a column
  /// an admin had typed into and throw the values away with no row-level failure to report — the app
  /// asking a question and then ignoring the answer.
  helpText        String?
  /// The "Required" column of the pro-forma. NOT NULL with a default, because "not stated" and "not
  /// required" are the same instruction to a researcher and a third state would have to be rendered
  /// on two clients for no gain.
  isRequired      Boolean  @default(false)
  /// When this question stopped being asked because answers had already been recorded against it.
  ///
  /// DISTINCT FROM isActive, WHICH ALREADY HAS AN OWNER. DELETE /questionnaire/questions/{id}
  /// (routes/questionnaire.py) soft-deletes by writing isActive = false and nothing else, and
  /// DELETE /questionnaire/sections/{id} does the same to every question under the section. So
  /// isActive alone cannot tell "a professor switched this off last March" from "this was retired
  /// because answers exist". The workbook re-upload needs that distinction and cannot fake it: it
  /// REACTIVATES a question it finds named in the workbook, and it must never reactivate a retired
  /// one — or downloading a questionnaire and uploading it back unchanged resurrects every question
  /// anybody ever replaced, each standing next to its replacement.
  retiredAt       DateTime?
  /// The question that replaced this one when an answered question was reworded. A PLAIN STRING
  /// COLUMN, not a Prisma self-relation and not a foreign key: it is only ever READ, to render
  /// "replaced by" and to keep the consolidated document from printing the two wordings as two
  /// unrelated questions with half the answers under each. A relation would add a join to every
  /// question read for one string on one screen, and the row it names cannot be gone while it is
  /// named — a replacement is created active, and an active question carrying an answer cannot be
  /// deleted because QuestionnaireResponse.question is Restrict.
  supersededById  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sectionId       String?

  questionnaire Questionnaire         @relation(fields: [questionnaireId], references: [id], onDelete: Restrict)
  /// Restrict, changed from SetNull on 2026-09-13. Nothing in this app hard-deletes a section —
  /// DELETE /questionnaire/sections/{id} flips `isActive` (routes/questionnaire.py:396-403) — so
  /// this forbids nothing that works today. What it stops is the silent version of the failure:
  /// SetNull left the questions invisible to every client (`section_payloads` drops a NULL
  /// sectionId) while their answers sat in the database, findable by nobody. A refusal at the FK is
  /// loud and recoverable; an orphan is neither.
  section   QuestionnaireSection? @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  responses QuestionnaireResponse[]

  @@index([sectionCode])
  @@index([sectionId])
  @@index([isActive])
  @@index([questionnaireId, isActive])
  /// Read by the consolidated document, which walks the supersede chain so a reworded question and
  /// its replacement print as one question rather than two with the answers split between them.
  @@index([supersededById])
}

model QuestionnaireInterview {
  id            String       @id @default(cuid())
  title         String
  interviewDate DateTime?
  place         String?
  language      String?
  notes         String?
  status        RecordStatus @default(PENDING)
  /// Review audit, identical to every other reviewable record. These were MISSING here while
  /// Artisan/Workshop/Product/Tool/Process/Media all had them, so the moment interviews became
  /// reviewable every approve raised
  ///   FieldNotFoundError: Could not find field at `updateOneQuestionnaireInterview.data.reviewNotes`
  /// which escaped as a bare 500 ("Failed to fetch" in the browser, HTTP 500 on Android).
  reviewNotes   String?
  reviewedById  String?
  reviewedAt    DateTime?
  extraMetadata Json?
  recordedAt    DateTime     @default(now())
  recordedTimezone String    @default("Asia/Kolkata")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdById   String
  locationId    String?
  // Deterministic key for the exact set of artisans this interview covers (sorted, comma-joined
  // artisan ids). Enforces ONE interview per artisan set PER INSTRUMENT — see
  // @@unique([questionnaireId, artisanSetKey]) below. NULL only when an interview has no artisans
  // (those are not deduped). A subset is a different set => different key.
  //
  // THE `@unique` ON THIS COLUMN ALONE WAS DROPPED 2026-09-13 and this is the reason: it meant one
  // artisan set could hold exactly one interview REPOSITORY-WIDE. The same artisans sat for the
  // 2nd-workshop instrument and must be able to sit again for the 3rd; under the old index the
  // second sitting FOLDED into the first (routes/questionnaire.create_interview) and the 3rd
  // workshop's answers landed on the 2nd workshop's interview. No value changed — `artisan_set_key`
  // computes exactly what it always did. Only the scope of the index moved.
  artisanSetKey String?
  /// The workshop this interview was conducted at, named EXPLICITLY on the record — previously an
  /// interview had no path to a workshop at all. Nullable, so every interview recorded before this
  /// column keeps behaving exactly as before.
  workshopId    String?
  /// WHICH INSTRUMENT THIS SITTING WAS TAKEN ON. NOT NULL: it is half of the uniqueness key below,
  /// and a nullable left column would make that index no constraint at all (Postgres treats NULLs
  /// as distinct), re-creating exactly the 133-rows-for-18-sets duplication that migration
  /// 20260622120000 spent 87 lines eliminating. Resolved on create as: the body's questionnaireId,
  /// else the workshop's bound instrument, else the default. Never changes afterwards —
  /// `QuestionnaireInterviewUpdate` has no such field and `APIModel` is `extra="forbid"`, so a
  /// client that tries gets a 422 from pydantic before the handler sees it.
  questionnaireId String

  createdBy User                             @relation("QuestionnaireCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  location  Location?                        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  workshop  Workshop?                        @relation("InterviewWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)
  questionnaire Questionnaire                @relation(fields: [questionnaireId], references: [id], onDelete: Restrict)
  artisans  QuestionnaireInterviewArtisan[]
  responses QuestionnaireResponse[]
  media     MediaFile[]                      @relation("QuestionnaireMedia")

  @@unique([questionnaireId, artisanSetKey])
  @@index([createdById])
  @@index([status])
  @@index([interviewDate])
  @@index([workshopId, createdAt])
  @@index([createdAt])
  @@index([questionnaireId, createdAt])
}

model QuestionnaireInterviewArtisan {
  interviewId String
  artisanId   String
  createdAt   DateTime @default(now())

  interview QuestionnaireInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  artisan   Artisan                @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@id([interviewId, artisanId])
  @@index([artisanId])
}

model QuestionnaireResponse {
  id          String   @id @default(cuid())
  interviewId String
  questionId  String
  answerText  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  answeredById String

  interview  QuestionnaireInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question   QuestionnaireQuestion  @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answeredBy User                   @relation("QuestionnaireAnsweredBy", fields: [answeredById], references: [id], onDelete: Restrict)

  @@unique([interviewId, questionId])
  @@index([questionId])
  @@index([answeredById])
}

model Process {
  id                  String       @id @default(cuid())
  name                String
  preProcessAvailable Boolean      @default(false)
  notes               String?
  status              RecordStatus @default(PENDING)
  reviewNotes         String?
  reviewedById        String?
  reviewedAt          DateTime?
  extraMetadata       Json?
  recordedAt          DateTime     @default(now())
  recordedTimezone    String       @default("Asia/Kolkata")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  productId           String
  createdById         String
  /// The workshop this process was documented at, named EXPLICITLY on the record. A process used to
  /// reach a workshop only through its parent product; both readings still work, and this column is
  /// nullable so every row recorded before it keeps behaving exactly as before.
  workshopId          String?
  /// The idempotency key of the create this row came from. See `Workshop.clientKey`.
  ///
  /// PROCESS HAS A HAZARD THE OTHER THREE DO NOT. `create_process` writes ProcessStep rows AFTER the
  /// row itself, and a create body carries no step ids — so a replay that re-ran `_sync_steps` would
  /// put every step in `to_create`, delete the originals, and hand the process a set of BRAND NEW
  /// step ids. `MediaFile.linkedRecordId` addresses those ids with NO foreign key (see the
  /// polymorphic pair on MediaFile above), and `_hydrate` finds a step's media by matching the
  /// CURRENT ids, so every photograph and clip captured against a step would become an orphan: still
  /// in the bucket, still a row, attached to nothing, and undetectable afterwards. The replay branch
  /// in `routes/processes.create_process` therefore answers from the stored row and reaches
  /// `_sync_steps` in exactly one case — a stored process with ZERO steps, which is the shape a
  /// create that committed its row and then failed on the step list leaves behind.
  clientKey           String?      @unique

  product   ProductDocumentation @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("ProcessCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  workshop  Workshop?            @relation("ProcessWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)
  steps     ProcessStep[]

  @@index([productId])
  @@index([createdById])
  @@index([status])
  @@index([workshopId, createdAt])
  @@index([createdAt])
}

model ProcessStep {
  id        String          @id @default(cuid())
  processId String
  name      String
  stepType  ProcessStepType @default(SEQUENTIAL)
  sortOrder Int
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
}

model ReviewLog {
  id         String           @id @default(cuid())
  recordType ReviewRecordType
  recordId   String
  status     RecordStatus
  notes      String?
  reviewerId String
  createdAt  DateTime         @default(now())

  reviewer User @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([recordType, recordId])
  @@index([reviewerId])
  @@index([createdAt])
}

// Singleton row (id = "singleton") holding master-admin-configurable global settings. For now: how
// audio transcripts are produced (raw / refined / refined+translated) and an optional off-peak window
// during which the heavy transcription+refinement work runs, so it doesn't compete with daytime
// uploads. Extend with more configurable fields over time.
model AppSetting {
  id                 String   @id @default("singleton")
  transcriptionMode  String   @default("REFINED_TRANSLATED")
  /// Speech-to-text providers in the order the master admin ranked them. One with no configured key
  /// is skipped where it sits, so this ranks preference and never gates transcription.
  sttProviderOrder   String[] @default(["elevenlabs", "deepgram", "whisper"])
  batchWindowEnabled Boolean  @default(false)
  batchWindowStart   String   @default("02:00")
  batchWindowEnd     String   @default("05:00")
  batchTimezone      String   @default("Asia/Kolkata")
  updatedAt          DateTime @updatedAt
  updatedById        String?
}

/// A workshop-to-researcher assignment made by an admin. Only researchers assigned to a workshop may
/// create records tied to it, and a submission made outside the workshop's [startDate, endDate] window
/// is flagged as needing admin approval. A workshop with NO assignment rows is open to everyone
/// (backward compatible with data created before assignments existed).
/// Who may work in a workshop, and at what level.
///
/// One row covers BOTH directions of the same relationship, because they settle into the same
/// state: an admin granting access to somebody, and a newly-onboarded user asking for it. The
/// difference is only where the row starts — an admin's grant begins GRANTED, a self-request begins
/// PENDING and needs an admin decision — so a single table means the grant list and the request
/// queue can never disagree about who currently has access.
model WorkshopAssignment {
  id           String   @id @default(cuid())
  workshopId   String
  userId       String
  assignedById String?
  /// VIEW (read the workshop's data), CONTRIBUTE (add records), EDIT (change anyone's records here).
  /// Ordered, so a check is a rank comparison rather than a set membership test.
  accessLevel  String   @default("CONTRIBUTE")
  /// PENDING (requested, awaiting an admin) / GRANTED / DENIED / REVOKED. Only GRANTED confers
  /// access; DENIED and REVOKED are kept rather than deleted so the decision stays auditable and a
  /// user cannot silently re-request their way around a refusal.
  status       String   @default("GRANTED")
  /// Set when the row began as the user's own request, so the queue can tell the two apart.
  requestedById String?
  requestNote  String?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workshop    Workshop @relation("WorkshopAssignments", fields: [workshopId], references: [id], onDelete: Cascade)
  user        User     @relation("WorkshopAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy  User?    @relation("WorkshopAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  requestedBy User?    @relation("WorkshopAssignmentRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?    @relation("WorkshopAssignmentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  // The unique below is the workshop-roster lookup `resolve_workshop_access` makes on every
  // workshop-scoped write; a separate [workshopId] would only duplicate its leading column.
  @@unique([workshopId, userId])
  @@index([userId])
  @@index([status])
}

/// A runtime-editable API key or service credential.
///
/// Keys used to live only in the EC2 `.env`, so rotating one meant an SSH session and a restart —
/// and nobody but the person holding the server could see whether a provider was even configured.
/// A master admin can now read (redacted), set and rotate them from the Settings hub, and the
/// services read through `services/managed_secrets.py`, which prefers a stored value and falls back
/// to the environment. That fallback is what makes this safe to deploy: an empty table behaves
/// exactly like today.
///
/// `value` is encrypted at rest with Fernet (see managed_secrets.py) rather than stored in the
/// clear, because a database dump of provider keys is a far worse leak than a config file on one
/// box. It is NEVER returned to a client in full — only a masked preview plus a reachability check.
model ManagedSecret {
  id          String   @id @default(cuid())
  /// The environment-variable name this overrides, e.g. "OPENAI_API_KEY".
  key         String   @unique
  /// Fernet ciphertext. Never logged, never serialised to a response.
  valueEnc    String
  /// Last four characters of the plaintext, so the UI can show "…a4f2" without decrypting.
  hint        String?
  description String?
  /// Result of the most recent reachability probe: UNKNOWN / OK / FAILED.
  lastStatus  String   @default("UNKNOWN")
  lastCheckedAt DateTime?
  lastError   String?
  updatedById String?
  updatedBy   User?    @relation("ManagedSecretUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// The verdict of the last "Test" of a provider key that lives in the deployed ENVIRONMENT.
///
/// WHY A SECOND TABLE. ManagedSecret is where a verdict belongs, but a row there only exists once
/// somebody SAVES a key through the Settings hub, and its whole purpose is to be an override — the
/// resolver prefers it over the environment. So recording an environment key's verdict by creating
/// one would copy the deployed secret into the database and change which value the transcription
/// chain uses, to persist a boolean. This table holds the boolean and nothing else, and it
/// overrides nothing. On production, where every key comes from the environment, it is the
/// difference between the provider ranking remembering what has been proven and resetting to
/// "nothing verified" on every deploy.
///
/// THE VALUE IS NOT HERE, IN ANY FORM. Not the key, not a prefix, not a digest of it. `fingerprint`
/// is HMAC-SHA256 of the value under a server-side pepper derived from SECRETS_ENCRYPTION_KEY (or
/// JWT_SECRET), so it cannot be computed, reversed or brute-forced from a database dump alone — the
/// pepper is not in the database. It exists for exactly one purpose: a rotated key must not inherit
/// the old key's pass. On a mismatch the verdict is ignored and the engine reads as untested, which
/// is also what happens if the pepper itself changes, i.e. the failure direction is "prove it
/// again" rather than "trust something unproven".
model SecretTestResult {
  /// The environment-variable name, e.g. "ELEVENLABS_API_KEY". One verdict per key.
  key         String   @id
  /// OK or FAILED. There is no UNKNOWN: a row exists only because a test was actually run.
  status      String
  checkedAt   DateTime
  /// The probe's short, redacted explanation of a failure. Never a provider response body.
  error       String?
  fingerprint String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Tiered data-access sharing between researchers. OWNER = the author whose uploaded records are being
/// shared; GRANTEE = the researcher who receives access at `tier` (DOWNLOAD < COMMENT < EDIT). Exactly
/// one row per (owner, grantee) pair: status PENDING is an outstanding request raised by the grantee;
/// GRANTED is active. `allData` true covers everything the owner uploaded; otherwise the covered set is
/// the explicit `scopeItems` subset.
model DataAccessGrant {
  id            String           @id @default(cuid())
  ownerId       String
  granteeId     String
  tier          DataAccessTier   @default(DOWNLOAD)
  status        DataAccessStatus @default(PENDING)
  allData       Boolean          @default(true)
  requestNote   String?
  decisionNote  String?
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  owner       User  @relation("DataAccessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  grantee     User  @relation("DataAccessGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  requestedBy User? @relation("DataAccessRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User? @relation("DataAccessDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  scopeItems  DataAccessScopeItem[]

  // [granteeId] stands alone because it is NOT the leading column of the unique, and it is the hot
  // one: `records.owned_or_granted_where` reads this table by grantee on every download and export
  // request from below professor. (It used to ride every LIST request too, under the older name
  // `visibility_where`, before reading the repository was opened to every signed-in account.)
  @@unique([ownerId, granteeId])
  @@index([granteeId])
  @@index([status])
}

/// One record in the subset covered by a non-allData DataAccessGrant.
model DataAccessScopeItem {
  id         String   @id @default(cuid())
  grantId    String
  recordType String
  recordId   String
  createdAt  DateTime @default(now())

  grant DataAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@unique([grantId, recordType, recordId])
}

/// A comment on any record (generic over recordType/recordId), left by the record owner, an admin, or a
/// user holding COMMENT-tier-or-higher data access to the owner.
model EntryComment {
  id         String   @id @default(cuid())
  recordType String
  recordId   String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User @relation("EntryCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([recordType, recordId])
  @@index([authorId])
}

/// An immutable audit row capturing one edit to a record's fields. `changes` is a JSON object shaped
/// {field: {old, new}}. Recorded whenever a record's fields change through the contribute path so an
/// admin can reconstruct the original values alongside every subsequent edit and see who made each one.
model RecordRevision {
  id         String   @id @default(cuid())
  recordType String
  recordId   String
  editedById String?
  changes    Json
  createdAt  DateTime @default(now())

  editedBy User? @relation("RecordRevisionEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([recordType, recordId])
  @@index([editedById])
}

/// ONE DESIGNER'S OWN KEY for one provider, encrypted with the same Fernet as ManagedSecret.
///
/// SEPARATE FROM ManagedSecret ON PURPOSE, and the separation is a permission boundary rather than
/// tidiness. A ManagedSecret is the DEPLOYMENT's key: one row per provider, written only by the
/// master admin from the Settings hub, and used by every request the server serves. A row here is
/// ONE PERSON's key, readable and writable only by that person, and used only for work they
/// themselves ask for. Putting both in one table would mean one careless `find_unique(where={"key":
/// ...})` served somebody else's credential to a provider on somebody else's behalf — and the
/// billing for that lands on a real person's card.
///
/// `model` is the designer's chosen model id, validated against `services/ai_providers` at write
/// time. It is nullable: a key with no model chosen runs the provider's default, which is what
/// somebody who pasted a key and pressed Save expects.
model UserAiCredential {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserAiCredentialOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// OPENAI | GEMINI | ANTHROPIC — the AiProvider enum in services/ai_providers.
  provider      String
  /// Fernet ciphertext. Never logged, never serialised to a response, never revealed — unlike a
  /// ManagedSecret there is no reveal endpoint for these, because no administrator has any business
  /// reading a designer's personal credential.
  valueEnc      String
  /// Last four characters of the plaintext, so the owner can tell two of their own keys apart.
  hint          String?
  /// The chosen model id. NULL means "the provider's default", resolved at call time so that a
  /// default which moves does not leave every designer pinned to a retired model.
  model         String?
  /// Result of the most recent reachability probe: UNKNOWN / OK / FAILED.
  lastStatus    String   @default("UNKNOWN")
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// One key per provider per person. A designer with two OpenAI keys has no way to say which one
  /// a given job should use, so the second replaces the first.
  @@unique([userId, provider])
  @@index([userId])
}
