generator client {
  provider                    = "prisma-client-py"
  interface                   = "asyncio"
  recursive_type_depth        = 5
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Six-tier role ladder, strictly ordered by privilege:
/// MASTER_ADMIN > ADMIN > PROFESSOR > RESEARCHER > FIELD_CONTRIBUTOR > CROWDSOURCE_VOLUNTEER.
/// Each tier inherits everything below it; grantable can* booleans lift single capabilities.
enum UserRole {
  MASTER_ADMIN
  ADMIN
  PROFESSOR
  RESEARCHER
  FIELD_CONTRIBUTOR
  CROWDSOURCE_VOLUNTEER
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

/// Where one email address stands with the institution — the SIGN-IN GATE's only vocabulary.
///
/// Four values and not two, because "never let in" and "let in and then stopped" are different
/// facts about a person and an audit a year from now has to be able to tell them apart. Both
/// refuse the sign-in; only one of them is a revocation.
///
/// ACTIVE is the ONLY value that admits. Every other value is a refusal, and any code that tests
/// for a row's EXISTENCE rather than for `status = ACTIVE` has written an authentication bypass —
/// PENDING rows are created by UNAUTHENTICATED sign-in attempts, so "a row exists" is a statement
/// an attacker can make come true about their own address. See `AccessRoster` and
/// `app/services/access_roster.py::roster_admits`.
enum AccessStatus {
  /// Somebody proved they own this address, was refused, and is waiting for an admin. Written by
  /// the sign-in path itself; see `AccessRoster.requestCount`.
  PENDING
  /// Admitted. The one value that lets a sign-in through.
  ACTIVE
  /// An admin looked at a PENDING request and said no. Distinct from SUSPENDED because this person
  /// was NEVER admitted, and distinct from deleting the row because a deleted row would go straight
  /// back into the admin's queue the next time they tried to sign in.
  REJECTED
  /// Was admitted, and an admin ended it. The account, its records and its authorship all survive —
  /// which is the entire reason access is a separate fact from `User.role`.
  SUSPENDED
}

enum RecordStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  /// Reviewer sent the record back with comments (reviewNotes); creator edits and resubmits.
  NEEDS_REVISION
}

/// Whether a `Workshop` row is a Design & Prototype Development Workshop or an ordinary craft
/// documentation visit. Both are `Workshop` rows and nothing used to tell them apart.
///
/// `DESIGN_PROTOTYPE` NAMES A THING THIS PRODUCT DOES NOT MODEL, and that is deliberate rather than
/// an oversight: there is no DesignWorkshop table here. It exists because the two repositories
/// coordinate their record vocabularies on purpose — see `ArtisanCreate.experienceYears`' 0..90
/// bound in schemas/records.py for the same decision made about a number — so a workshop recorded
/// here and later adopted by the sibling product can carry the same mark.
///
/// `OTHER` is the default so every workshop recorded before this column keeps behaving exactly as
/// it did — the list is unchanged unless somebody marks a row.
enum WorkshopType {
  DESIGN_PROTOTYPE
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  OTHER
}

enum ProductType {
  FINISHED_GOOD
  SAMPLE
  RAW_MATERIAL
  COMPONENT
  PACKAGING
  OTHER
}

enum MarketDemand {
  LOW
  MEDIUM
  HIGH
  SEASONAL
  UNKNOWN
}

enum MakerType {
  ARTISAN
  LOCAL_BLACKSMITH
  CARPENTER
  WORKSHOP
  FACTORY
  UNKNOWN
  OTHER
}

enum TraditionType {
  TRADITIONAL
  MODERN
  HYBRID
  UNKNOWN
}

enum ReviewRecordType {
  ARTISAN
  WORKSHOP
  PRODUCT
  TOOL
  // Processes and interviews carry a status and can be pinned PENDING by the late-submission
  // gate, so they have to be reviewable like any other record.
  PROCESS
  QUESTIONNAIRE
  MEDIA
}

enum MediaProcessingJobType {
  TRANSCRIPTION
  MEASUREMENT
}

enum MediaProcessingJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProcessStepType {
  SEQUENTIAL
  GROUP
}

/// Tiers of cross-researcher data access, strictly increasing in privilege:
/// DOWNLOAD (minimum) < COMMENT (medium) < EDIT (maximum). Each tier includes everything below it.
enum DataAccessTier {
  DOWNLOAD
  COMMENT
  EDIT
}

/// Lifecycle of a DataAccessGrant row. PENDING = a request from the grantee awaiting the owner's
/// decision; GRANTED = active; DENIED = owner refused; REVOKED = owner withdrew a previously active grant.
enum DataAccessStatus {
  PENDING
  GRANTED
  DENIED
  REVOKED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  role         UserRole     @default(RESEARCHER)
  authProvider AuthProvider @default(LOCAL)
  canManageQuestionnaire Boolean @default(false)
  canManageCrafts        Boolean @default(false)
  canManageWorkshops     Boolean @default(false)
  canReview              Boolean @default(false)
  canViewProvenance      Boolean @default(false)
  canDownloadDataset     Boolean @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  artisans  Artisan[]              @relation("ArtisanCreatedBy")
  crafts    Craft[]                @relation("CraftCreatedBy")
  workshops Workshop[]             @relation("WorkshopCreatedBy")
  products  ProductDocumentation[] @relation("ProductCreatedBy")
  tools     ToolDocumentation[]    @relation("ToolCreatedBy")
  processes Process[]              @relation("ProcessCreatedBy")
  media     MediaFile[]            @relation("MediaUploadedBy")
  requestedMediaProcessingJobs MediaProcessingJob[] @relation("MediaProcessingRequestedBy")
  reviews   ReviewLog[]            @relation("ReviewReviewer")
  questionnaireInterviews QuestionnaireInterview[] @relation("QuestionnaireCreatedBy")
  questionnairesCreated   Questionnaire[]          @relation("QuestionnaireInstrumentCreatedBy")
  questionnaireResponses QuestionnaireResponse[] @relation("QuestionnaireAnsweredBy")
  appReleases AppRelease[] @relation("AppReleasePublishedBy")
  feedback    Feedback?    @relation("FeedbackUser")
  preferences UserPreference? @relation("UserPreferenceUser")
  sectionStatusesSet QuestionnaireSectionStatus[] @relation("SectionStatusSetBy")
  workshopAssignments     WorkshopAssignment[] @relation("WorkshopAssignmentUser")
  workshopAssignmentsMade WorkshopAssignment[] @relation("WorkshopAssignmentAssignedBy")
  workshopAccessRequests  WorkshopAssignment[] @relation("WorkshopAssignmentRequestedBy")
  workshopAccessDecisions WorkshopAssignment[] @relation("WorkshopAssignmentDecidedBy")
  managedSecretsUpdated   ManagedSecret[]      @relation("ManagedSecretUpdatedBy")
  aiCredentials           UserAiCredential[]   @relation("UserAiCredentialOwner")
  dataAccessAsOwner   DataAccessGrant[] @relation("DataAccessOwner")
  dataAccessAsGrantee DataAccessGrant[] @relation("DataAccessGrantee")
  dataAccessRequested DataAccessGrant[] @relation("DataAccessRequestedBy")
  dataAccessDecided   DataAccessGrant[] @relation("DataAccessDecidedBy")
  entryComments   EntryComment[]   @relation("EntryCommentAuthor")
  recordRevisions RecordRevision[] @relation("RecordRevisionEditedBy")
  tasksAssigned   AssignedTask[]   @relation("TaskAssignee")
  tasksCreated    AssignedTask[]   @relation("TaskCreator")
  accessDecisions AccessRoster[]   @relation("AccessRosterDecidedBy")

  @@index([role])
}

/// THE SIGN-IN GATE. One row per email address the institution has an opinion about.
///
/// WHY THIS IS KEYED BY EMAIL AND NOT BY `User.id`. An admin has to be able to admit somebody
/// BEFORE their account exists — that is the whole point. This application has no password
/// self-registration and no invitation email; the only way a person who has never been here gets an
/// account is by signing in with Google, and until they do there is no `User` row to point at. So
/// the roster is a list of ADDRESSES, and the account attaches itself to the row on first sign-in.
///
/// WHY THIS IS A SEPARATE FACT FROM `User.role`, and must stay one. The role column is read when
/// deciding who may review whose work and whose records may be edited (`deps.can_review_record`,
/// `deps.can_edit_others_record`), so revoking access by demoting somebody to the bottom tier is
/// RETROACTIVE: it silently rewrites the standing of every record they ever created and every
/// review they ever signed. Suspending a roster row ends their sign-ins and leaves the authorship
/// of their fieldwork exactly as it was. Anyone tempted to "simplify" this by adding an
/// `isDisabled` boolean to `User` is proposing that revocation and demotion be the same operation;
/// they are not.
///
/// THE ROWS IN THIS TABLE ARE WRITTEN BY UNAUTHENTICATED CALLERS. A PENDING row is created by the
/// sign-in path itself, by anybody who can prove they own an email address (see
/// `app/services/access_roster.py::record_access_request` for what "prove" means and what bounds
/// the write). Therefore: **existence of a row admits nobody.** Only `status = ACTIVE` admits, and
/// any query here that tests for a row rather than for the status has written an authentication
/// bypass that an attacker can trigger on their own address in one HTTP request.
model AccessRoster {
  id String @id @default(cuid())

  /// Lower-cased on every write, by `access_roster.normalise_email` and nowhere else. Joined to
  /// `User.email`, which is itself unique and also stored lower-cased by the auth path. A roster
  /// row typed `A.Sharma@Example.org` that never matches the account signing in as
  /// `a.sharma@example.org` is a person locked out of the application by a capital letter, with an
  /// admin looking straight at the row that was supposed to let them in.
  email String @unique

  /// PENDING by default, because the default way a row comes into existence is a refused sign-in.
  /// An admin adding somebody ahead of time passes ACTIVE explicitly.
  status AccessStatus @default(PENDING)

  /// The tier the account is PROVISIONED at when this address first signs in successfully.
  ///
  /// "All the users by default join as the lowest rung unless promoted there itself" — so the
  /// default is the bottom of the ladder, and the "promoted there itself" is an admin changing this
  /// column on the roster screen while approving the request.
  ///
  /// AUTHORITATIVE ONLY UNTIL THE ACCOUNT EXISTS. Once there is a `User` row, `User.role` is the
  /// role, and this column is a historical note about what they were let in as. It is deliberately
  /// NOT re-applied on later sign-ins: doing so would let a stale roster row silently DEMOTE an
  /// admin who was promoted through `PATCH /users/{id}` afterwards, and the demotion would be
  /// invisible in the login response.
  grantedRole UserRole @default(CROWDSOURCE_VOLUNTEER)

  /// Written by an ADMIN only, never by the sign-in path. See the module docstring of
  /// `app/services/access_roster.py`: a display name taken from an unverified source is
  /// attacker-controlled text rendered in an admin's queue, and the queue is the one screen in this
  /// product a stranger can cause content to appear on.
  fullName String?
  notes    String?

  /// DATE OF JOINING THE PLATFORM — the requirement's own words, and the reason this column is not
  /// just `createdAt`. `createdAt` is when the ROW appeared, which for a refused stranger is the
  /// day they were turned away, not the day they joined. `joinedAt` is stamped when the address is
  /// first admitted (status becomes ACTIVE), and the grandfathering migration back-fills it from
  /// `User.createdAt` so that every account that predates the gate shows the date it really joined
  /// rather than the date this feature shipped.
  joinedAt DateTime?

  /// The first time an admitted address actually SIGNED IN. Distinct from `joinedAt`: an admin
  /// approves five people in March and in April needs to know which of them ever opened the app —
  /// an approval nobody acted on looks identical to one that was ignored. Written once (the WHERE
  /// clause carries `firstSeenAt: null`), so two simultaneous logins cannot race it.
  firstSeenAt DateTime?

  /// HOW OFTEN THIS ADDRESS HAS BEEN TURNED AWAY, and the reason one person hammering the sign-in
  /// form is one row rather than a thousand. Deduping by email is what makes the unauthenticated
  /// write bounded: a repeat attempt is an UPDATE of these two columns, never an INSERT.
  ///
  /// It is also the only signal an admin has that a REJECTED person keeps trying — the re-attempt
  /// deliberately does not re-open the request (see `record_access_request`), so without a counter
  /// their persistence would be invisible.
  requestCount     Int      @default(1)
  firstRequestedAt DateTime @default(now())
  lastRequestedAt  DateTime @default(now())

  /// Who decided, and when. `SetNull` rather than `Cascade`: an admin leaving the institution must
  /// not erase the record that a decision was taken, only who took it.
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?     @relation("AccessRosterDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `status` alone answers the pending COUNT (the notification), which admins poll; the composite
  /// answers the pending LIST, which is ordered by most-recently-asked so the queue reads as a
  /// queue. `email` is already indexed by its unique constraint — that is the gate's own lookup and
  /// it runs on every single sign-in, so it must never become a sequential scan.
  @@index([status])
  @@index([status, lastRequestedAt])
  @@index([decidedById])
}

/// A documentation task assigned by an admin/master admin to a user, so field work is
/// planned and tracked. Status is a plain String (OPEN | IN_PROGRESS | DONE | CANCELLED)
/// for client compatibility.
/// A documentation assignment: what somebody has been asked to record, and how far along they are.
///
/// One row is always ONE assignee, so progress and accountability stay per-person; assigning the
/// same work to five researchers writes five rows sharing a `batchId`. The scope columns describe
/// the work without naming a specific record, because the record usually does not exist yet — that
/// is the point of the task. A task can therefore say "record products and tools for these three
/// artisans in this workshop" or "answer questionnaire sections C and D for every artisan you have",
/// and `targetCount` turns either into a countable goal.
model AssignedTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("OPEN")
  dueAt       DateTime?
  completedAt DateTime?
  /// Legacy single-record link, kept so existing rows and the old create path keep working.
  recordType  String?
  recordId    String?
  /// The workshop this work belongs to. Everything a researcher does is workshop-scoped, so the
  /// assignment screen starts by picking one and every task it creates carries it.
  workshopId  String?
  workshop    Workshop? @relation("TaskWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)
  /// Which kinds of record to produce: artisan / product / process / tool / questionnaire / media.
  /// A list, so "record products AND tools" is one task rather than two.
  recordTypes String[]  @default([])
  /// Optional narrowing to specific artisans. Empty = every artisan in scope for the assignee.
  artisanIds  String[]  @default([])
  /// Questionnaire sections this person is responsible for. Empty = not a questionnaire task.
  sectionIds  String[]  @default([])
  /// How many records of the given types to produce. Null = "as many as apply".
  targetCount Int?
  /// Assignee-reported progress toward targetCount, so a partly-done task is visible as such.
  progressCount Int     @default(0)
  /// Shared by every row created in one assignment action, so the creator can see and manage the
  /// batch ("record tools for these 5 people") as a single unit.
  batchId     String?
  assigneeId  String
  assignee    User      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assigneeId, status])
  @@index([createdById])
  @@index([workshopId])
  @@index([batchId])
}

/// One piece of app feedback per user: a quantitative rating (1–5) plus a qualitative comment.
/// Upserted, so a user can revisit and update their feedback at any time. The master admin reviews
/// everyone's feedback on the View Data screen.
model Feedback {
  id        String   @id @default(cuid())
  userId    String   @unique
  // Quantitative (each 1–5). `rating` is the overall score; the rest are per-aspect sub-ratings.
  rating        Int?
  easeOfUse     Int?
  reliability   Int?
  performance   Int?
  design        Int?
  features      Int?
  recommend     Int?
  // Qualitative free text. `comment` is the general note; the rest are targeted prompts.
  comment         String?
  likeMost        String?
  improve         String?
  bugs            String?
  featureRequests String?
  role            String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("FeedbackUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

/// One row per user holding their appearance + accessibility choices, upserted exactly like
/// Feedback so a user can flip a switch on any device and have it follow their account. `theme`
/// is a plain String (system | light | dark) rather than an enum, matching the client contract and
/// keeping future options additive.
model UserPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  theme         String   @default("system")
  reducedMotion Boolean  @default(false)
  largerText    Boolean  @default(false)
  highContrast  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation("UserPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)
}

/// A published Android app build that the master admin pushed out as an over-the-air update. The
/// highest versionCode is the current release; clients compare their installed versionCode and
/// self-update from `url`.
model AppRelease {
  id            String   @id @default(cuid())
  versionCode   Int
  versionName   String
  objectKey     String
  url           String?
  notes         String?
  publishedById String?
  publishedBy   User?    @relation("AppReleasePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime @default(now())

  @@index([versionCode])
}

model Craft {
  id            String   @id @default(cuid())
  name          String   @unique
  localName     String?
  category      String?
  description   String?
  place         String?
  extraMetadata Json?
  recordedAt    DateTime @default(now())
  recordedTimezone String @default("Asia/Kolkata")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  /// The workshop this craft was documented at, named EXPLICITLY on the record. Additive to the
  /// WorkshopCraft join (which every existing query reads through and which is kept in lock-step);
  /// nullable, so every row recorded before this column keeps behaving exactly as before.
  workshopId    String?

  createdBy User?                  @relation("CraftCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  workshop  Workshop?              @relation("CraftWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)
  artisans  Artisan[]
  products  ProductDocumentation[]
  tools     ToolDocumentation[]
  // The tools linked to this craft through the JOIN, beside the `tools` back-relation above, which
  // is the `ToolDocumentation.craftId` column. Spelled `toolLinks` because `Artisan` already spells
  // its `ToolArtisan` back-relation that way, and two join tables off one parent that name
  // themselves differently is how a later reader comes to believe one of them means something the
  // other does not.
  toolLinks ToolCraft[]
  media     MediaFile[]
  workshops WorkshopCraft[]

  // `name` needs no index of its own: @unique already builds one, and that is what the alphabetical
  // craft picker orders by.
  @@index([workshopId])
}

/// TWO ANSWERS TO TWO DIFFERENT QUESTIONS, and reading one as the other is what this model was
/// changed to stop.
///
/// Every one of the fifteen artisans on the live database that carries a location sits between
/// 22.313 and 22.315 N, 87.309 and 87.313 E — Kharagpur, West Bengal — while the places their
/// researchers typed are Bagru, Balotra, Kutch, Rudraprayag, Ballupur, Sanganer and Kappaladoddi,
/// none of them within 1,500 km of that point. The coordinates are not wrong and are not a
/// hardcoded constant: they jitter naturally and carry genuine accuracy values from 26 m to
/// 2,506 m. They are real GPS fixes of the DESK THE RECORD WAS TYPED AT, which is ordinary,
/// reasonable behaviour that the schema had no way to express — so the fix got read as the
/// artisan's address, and the researchers hand-encoded the real village and district into a
/// free-text `place` box because there was nowhere else to put them.
///
/// So the columns below are two groups, and the group a column belongs to decides who may write it:
///
///   PROVENANCE — latitude, longitude, altitude, accuracy, capturedAt, placeName, address.
///     Where the DEVICE was. Written automatically. Never presented as the subject's address, and
///     never copied into the group below.
///
///   STATED ADDRESS — state, district, village, pincode, subjectLatitude, subjectLongitude.
///     Where the SUBJECT is, as a statement by the researcher. A geocoder may offer a value here;
///     only a person may write one.
///
/// NOTHING IS BACKFILLED and no existing value moves. The fifteen rows keep exactly the
/// coordinates they have, which are exactly what the provenance group means; their stated address
/// stays empty until a researcher fills it in, and the mismatch between the two is FLAGGED in the
/// form rather than guessed at here.
model Location {
  id            String   @id @default(cuid())
  /// PROVENANCE. Where the device was — kept NOT NULL because that is what the fifteen live rows
  /// already are, and because every record still has to carry a coordinate somebody stood at,
  /// pointed at, or typed (see require_location in app/schemas/common.py).
  latitude      Float
  longitude     Float
  altitude      Float?
  /// PROVENANCE. Radius of the fix in metres. Load-bearing rather than decorative: a browser with
  /// no satellite lock reports kilometres while returning coordinates that look every bit as
  /// precise, and one live row has a 2,506 m radius. Past PINCODE_ACCURACY_LIMIT_METRES the clients
  /// decline to derive an address from the point at all.
  accuracy      Float?
  address       String?
  placeName     String?
  /// STATED. Postal state or union territory, stored as the canonical name from the closed list in
  /// services/address.py — which api/routes/reference.py also SERVES, so a form's dropdown and the
  /// validator can never hold different lists. Free text here would split one state across four
  /// spellings in every group-by and export, the way craft names did before title-casing.
  state         String?
  /// STATED. Canonical district within `state`, from the same served list. A REAL COLUMN rather
  /// than an extraMetadata key: "District" has been a shipped, user-visible column since the
  /// record-field registry was written (the data browser card, the browser table, every
  /// details.txt in /export/dataset, the artisan sheet of /data/report), it read a metadata key
  /// nothing has written since the artisan form stopped writing extraMetadata, and it has therefore
  /// been blank on every record. Districts are only meaningful per state — several names are shared
  /// by two states — so the pair is validated together, never apart.
  district      String?
  /// STATED. The village or hamlet, free text, because no closed list of Indian villages exists
  /// that a field researcher could pick from. It sits BELOW district on purpose: district is the
  /// finest administrative unit that can be checked, and village is the finest that can be named.
  village       String?
  /// STATED. Indian PIN code as the bare 6 digits ("380001"). Validated as exactly six ASCII digits
  /// with a leading 1–9: the first digit is the postal zone and there is no zone 0.
  pincode       String?
  /// STATED. The optional precise pin a researcher drops on the SUBJECT'S place — deliberately not
  /// `latitude`/`longitude`, which mean the device. One pair cannot mean both: the moment a pin and
  /// a fix share a column, an export of "artisan coordinates" is a mixture of the two with no way
  /// to tell which row is which, which is the bug this model was changed to end. NULL on every row
  /// that has only ever been auto-captured, and NULL is the honest answer there.
  subjectLatitude  Float?
  subjectLongitude Float?
  /// PROVENANCE. When the device produced the fix above.
  capturedAt    DateTime?
  extraMetadata Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  artisans  Artisan[]
  workshops Workshop[]
  products  ProductDocumentation[]
  tools     ToolDocumentation[]
  media     MediaFile[]
  questionnaireInterviews QuestionnaireInterview[]

  // Nothing reads this table by any column. `attach_location` writes a row, and every reader
  // afterwards arrives by primary key through the `location` relation — so an index here is paid for
  // on every record create and never collected on. (latitude, longitude) and placeName went for that
  // reason, and because neither could have served its own query anyway: a bounding box or a radius
  // wants GiST, not a btree on two independent floats, and a place name typed into a search box
  // reaches Postgres as ILIKE '%…%'.
  //
  /// "Every record in Gujarat" is the query this column exists to make possible; without the index
  /// it is a sequential scan of every location ever captured. Kept although no route issues it yet:
  /// it is an equality against a closed list of canonical names, which is the one shape here a btree
  /// genuinely answers, so this index is waiting for its query rather than hoping for one.
  ///
  /// `district` gets NO index of its own, and no composite with `state` either. A district is only
  /// ever asked for inside a state, so this index already narrows the scan to one state's rows and
  /// the district is a cheap filter on top; a second index would be written on every record create
  /// to save a predicate no route issues yet. The moment "every record in Kutch" becomes a query
  /// somebody runs, make it @@index([state, district]) and delete this one — the composite answers
  /// the state-only query by prefix, so the pair would be two writes for one query shape.
  @@index([state])
}

model Artisan {
  id            String       @id @default(cuid())
  name          String
  localName     String?
  gender        String?
  phone         String?
  email         String?
  place         String
  /// The artisan's Aadhaar number, stored as the bare 12 digits. This is the DEDUPLICATION KEY:
  /// the same person documented at two workshops by two researchers must collapse to one record,
  /// and this unique index is what enforces it. Validated (12 digits, leading 2–9, Verhoeff
  /// checksum) in services/artisan_identity.py, and MASKED to "XXXX XXXX 9012" on every exported or
  /// shared surface.
  ///
  /// REQUIRED to create an artisan, and enforced by ArtisanCreate rather than by NOT NULL. The
  /// column stays nullable on purpose: production holds artisans recorded before this field existed,
  /// and the only ways to satisfy a NOT NULL would be to invent numbers for them (fabricating a
  /// national ID, which would also collide with this very unique index) or to delete them. Both are
  /// unacceptable, so those rows keep NULL — readable, editable, and exempt from the unique index,
  /// since Postgres permits any number of NULLs under one. Same pattern as dos/donts above.
  aadhaarNumber String?      @unique
  /// Does this artisan hold an Artisan Pehchan Card (the PM Vishwakarma ID)? Defaults to true,
  /// matching the form's default answer.
  pehchanCardAvailable Boolean @default(true)
  /// The Pehchan card number, normalised to uppercase alphanumerics. Required exactly when
  /// pehchanCardAvailable is true, and force-cleared to NULL when it is false, so a card number can
  /// never be orphaned on a record that says it has no card.
  pehchanCardNumber String?  @unique
  address       String?
  notes         String?
  /// DATE OF BIRTH, AND DELIBERATELY NOT AN AGE COLUMN.
  ///
  /// The design workshop's participant table asks every artisan for an Age and an Experience, and
  /// until these two columns existed this table could answer neither: both were read out of legacy
  /// `extraMetadata` spellings that researchers used before the record form was structured, and the
  /// form stopped writing free metadata a long time ago. So an artisan IMPORTED into a workshop
  /// arrived with both boxes blank and an artisan ADDED from the workshop had nowhere to put them —
  /// the designer typed them in from a printout, which is the exact behaviour the reference picker
  /// exists to end. `participant.experienceYears` is a TABLE_COLUMN, so the blank printed in every
  /// submitted report.
  ///
  /// It is a DATE and not a number because an age column is wrong within a year of being written
  /// and nothing in this system would ever notice: a record entered as "42" is silently "42" for
  /// the rest of its life. Age is derived from this at read time — see `derive_age` in
  /// services/records — so it is right on the day it is printed and right again next year.
  dateOfBirth   DateTime?
  /// THE DAY THIS ARTISAN BEGAN PRACTISING THE CRAFT, and the feeder `experienceYears` is derived
  /// from.
  ///
  /// It is the same argument `dateOfBirth` above makes, applied to the same table one column later.
  /// A stated NUMBER of years is right on the day it is written and silently wrong from then on; a
  /// stated DATE is right on the day it is printed and right again next year, with nobody editing
  /// anything. `record_fields.py`'s "Experience (years)" row feeds the data browser card, the
  /// /data/report workbook, details.txt inside the dataset zip and both /export CSVs, so the decay
  /// is not theoretical — it prints, in files a ministry reader opens, years after the visit.
  ///
  /// NULL ON EVERY ROW THAT EXISTS TODAY, deliberately, and the migration that adds this column
  /// (20260913120000) refuses to backfill it. Read that file before adding one: a date computed
  /// from `experienceYears` and `recordedAt` would carry no information those two columns do not
  /// already carry, and it would permanently destroy the difference between a date a human stated
  /// and a date a script guessed — at which point `derive_experience_years` would start inflating
  /// the guess with the calendar.
  craftStartDate DateTime?
  /// Years this artisan has practised the craft, AS SOMEBODY STATED IT. It is no longer the only
  /// answer to that question: `craftStartDate` above is, when a row has one, and the readers derive
  /// from the date in preference to this number. See `derive_experience_years` in services/records.
  ///
  /// IT IS STILL COLLECTED AND STILL READ, and this paragraph used to be the argument for it being
  /// the ONLY thing collected: "A number and not a date, because the thing a designer knows is
  /// 'about thirty years' and the year they started is a harder question that gets a rounder, less
  /// honest answer." That half is still true and is why the number box did not go away — an artisan
  /// who says "about thirty years" and cannot name a year still has to be recordable, and on every
  /// row written before 20260913120000 this column (or the legacy `extraMetadata` spelling behind
  /// it) is the only answer that exists. What changed is that a researcher who CAN name the year is
  /// no longer forced to convert it into a number that starts decaying the moment they type it.
  ///
  /// The rest of that paragraph was a statement of the cost of storing a number, and it stands
  /// unaltered for every row that has no `craftStartDate`: this value ages with the RECORD rather
  /// than with the artisan, so an artisan documented in 2024 with 30 years reads 30 in 2030.
  /// `recordedAt` is on the same row, so a reader can always tell how old the statement is, and
  /// inflating it automatically would be inventing a fact nobody stated.
  experienceYears Int?
  /// THE REMAINING MONTHS OF THAT SAME EXPERIENCE, 0-11, and never a total.
  ///
  /// The requirement is TWO DROPDOWNS ON ONE LINE — "5 years" beside "6 months" — and the read-back
  /// has to hand the form back exactly what was chosen. So this is a second column and NOT an
  /// `experienceTotalMonths` that the two boxes are computed out of. A single stored 66 has to be
  /// re-divided on every read, and that arithmetic cannot tell "5 years and 6 months" from
  /// "66 months" from "five and a half years"; it would also make `experienceYears` beside it a
  /// DERIVED column overnight — a column four export surfaces read — to save one integer of storage.
  ///
  /// IT SITS EXACTLY WHERE `experienceYears` SITS IN THE PRECEDENCE: behind the date, never in front
  /// of it.
  ///
  /// NULLABLE AND NOT `@default(0)`, which is also why the migration that adds it backfills nothing.
  /// Every row in this table was written by a form that asked for years alone. A zero default would
  /// put "and no months" on record for all of them as a stated fact, and the second dropdown would
  /// open with an answer already selected on records whose artisan was never asked the question.
  /// Absent and zero are different answers, and NULL is the only one of the two that is true here.
  ///
  /// Bounded 0..11 by `CHECK ("experienceMonths" BETWEEN 0 AND 11)` in migration 20260913120000 AND
  /// by ge/le on ArtisanCreate/ArtisanUpdate — the CHECK because the database must not hold twelve
  /// months, the pydantic bound because a CHECK violation arrives as a bare 500 naming no field.
  ///
  /// IT REACHES NO EXPORT SURFACE, and that is a decision rather than an omission: a months column
  /// in a ministry-facing header is an owner call with its own blast radius, and the sibling
  /// repository made the same choice. The value stops at the API.
  experienceMonths Int?
  // Newline-separated, numbered guidance for working with this artisan: dos = positive prompt (what to
  // do / emphasise), donts = negative prompt (what to avoid). Required on new records; nullable so the
  // existing rows from before this field can be backfilled later instead of blocking the migration.
  dos           String?
  donts         String?
  status        RecordStatus @default(PENDING)
  reviewNotes   String?
  reviewedById  String?
  reviewedAt    DateTime?
  extraMetadata Json?
  recordedAt    DateTime     @default(now())
  recordedTimezone String    @default("Asia/Kolkata")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  craftId       String?
  locationId    String?
  createdById   String
  /// The workshop this artisan was documented at, named EXPLICITLY on the record. Additive to the
  /// WorkshopArtisan join (which every existing query reads through and which is kept in lock-step);
  /// nullable, so every row recorded before this column keeps behaving exactly as before.
  workshopId    String?

  craft     Craft?                 @relation(fields: [craftId], references: [id], onDelete: SetNull)
  location  Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy User                   @relation("ArtisanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  workshop  Workshop?              @relation("ArtisanWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)
  workshops WorkshopArtisan[]
  products  ProductDocumentation[]
  tools     ToolDocumentation[]
  toolLinks ToolArtisan[]
  media     MediaFile[]
  questionnaireInterviews QuestionnaireInterviewArtisan[]
  sectionStatuses QuestionnaireSectionStatus[]

  // `name` earns its index by being the sort key of the artisan pickers, not by the search box:
  // every text search in this app is a case-insensitive `contains`, which Postgres runs as ILIKE
  // '%…%' and no btree can answer. That is why `place` and the denormalised name columns on
  // Product/Tool carry no index — see the migration notes in 20260726200000_index_coverage.
  @@index([name])
  @@index([craftId])
  @@index([createdById])
  @@index([status])
  // Equality first, then the sort column: every record list is `ORDER BY createdAt DESC LIMIT n`,
  // so a workshop-filtered page reads n rows straight off the index instead of sorting the whole
  // workshop. The bare [createdAt] serves the same list unfiltered, which is what an admin sees.
  @@index([workshopId, createdAt])
  @@index([createdAt])
}

model Workshop {
  id            String       @id @default(cuid())
  title         String
  /// Whether this is a Design & Prototype Development Workshop or an ordinary one. See the enum.
  workshopType  WorkshopType @default(OTHER)
  date          DateTime
  startDate     DateTime?
  endDate       DateTime?
  place         String
  description   String?
  notes         String?
  status        RecordStatus @default(PENDING)
  reviewNotes   String?
  reviewedById  String?
  reviewedAt    DateTime?
  extraMetadata Json?
  recordedAt    DateTime     @default(now())
  recordedTimezone String    @default("Asia/Kolkata")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  locationId    String?
  createdById   String
  /// THE INSTRUMENT IN USE AT THIS WORKSHOP — the answer to "which questions apply here", chosen
  /// once by an admin rather than re-decided by every researcher who opens the capture form.
  ///
  /// HOW THIS COMPOSES WITH `AssignedTask.sectionIds`, which already answers a neighbouring
  /// question: this column chooses the INSTRUMENT, that array chooses WHICH PARTS OF IT one person
  /// owns. A set and a subset, not two answers — and `tasks.resolve_scope` now refuses a subset
  /// that is not one.
  ///
  /// NULLABLE = "not chosen yet", which resolves to the default instrument. Every workshop that
  /// existed on 2026-09-13 was BACKFILLED to the 2nd-workshop instrument instead of being left
  /// NULL, because leaving them NULL would mean that the day an operator flips `isDefault` to the
  /// 3rd instrument, every historical workshop silently changes which instrument it is recorded as
  /// having used. SetNull on delete: retiring an instrument must not delete a workshop.
  questionnaireId String?
  /// THE CREATE THIS ROW CAME FROM, NAMED BY THE CLIENT THAT QUEUED IT — the idempotency key that
  /// makes an offline replay land once, however many times it is sent. THIS IS THE CANONICAL COPY
  /// OF THE ARGUMENT; the same column on ProductDocumentation, ToolDocumentation and Process points
  /// back here rather than restating it.
  ///
  /// ── THE DUPLICATE THIS CLOSES, WHICH BOTH OUTBOXES HAD WRITTEN DOWN AS UNCLOSABLE ──────────
  ///
  /// A queued create is POSTed, the server writes the row, and the answer is lost on the way back:
  /// a tunnel, a captive portal, the process killed by the OS while the request was in flight. The
  /// client learned nothing, so the entry is still queued and the next pass sends it again. Both
  /// clients guard the case they CAN see — `frontend/lib/offline.ts` writes `createdId` the moment
  /// an answer lands and the drain reads it back; Android's `PendingEntry.createdId`
  /// (data/Offline.kt) says "non-null means the record IS on the server". Neither can guard the case
  /// where the answer never arrived at all, because both are records of a REPLY, and this
  /// repository's own `persistProgress` says so in as many words: *"a few milliseconds of IndexedDB
  /// is as small as that window gets without idempotency keys on the API."* This is that key.
  ///
  /// IT IS ALSO THE ONLY GUARD THAT CROSSES A DEVICE OR A PROFILE. `createdId` is a fact ONE browser
  /// profile — or one handset's queue file — holds about its own send. A queue restored onto a
  /// second handset, or drained after a sign-out and back in, holds no such record, and the same
  /// fieldwork is then filed twice under one researcher's name in a register nobody reconciles.
  ///
  /// ── WHY A PLAIN `@unique` ON A NULLABLE COLUMN, AND NOT A PARTIAL INDEX ────────────────────
  ///
  /// Postgres permits any number of NULLs under a unique index, so `String? @unique` ALREADY IS the
  /// partial index: `CREATE UNIQUE INDEX … WHERE "clientKey" IS NOT NULL` builds the same guarantee
  /// while being inexpressible in this file, which would leave the schema and the database
  /// describing different tables. `Artisan.aadhaarNumber` above carries the identical argument for
  /// the identical reason ("Postgres permits any number of NULLs under one"), and this follows it
  /// rather than inventing a second treatment of one problem.
  ///
  /// FOUR MODELS AND NOT SIX. `Artisan.aadhaarNumber` and `Craft.name` are @unique already and each
  /// answers a pre-write 409 naming the row that holds the value, so a replayed create of either is
  /// refused by the dedup key that exists for exactly that purpose. A second mechanism beside either
  /// would be two guards that can disagree about what a duplicate is.
  ///
  /// NULL IS TODAY'S BEHAVIOUR, EXACTLY. Every row written before this column has none, no backfill
  /// invents one, and a create that sends no key is written and answered precisely as it was before
  /// — which is what every fielded APK and every cached web bundle does. See
  /// `services/records.client_key_replay` for what a key that IS sent buys, and
  /// `routes/workshops.create_workshop` for why the replay branch REPAIRS an empty roster instead of
  /// either skipping the roster writes or re-running them unconditionally.
  clientKey     String?      @unique

  location  Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy User                   @relation("WorkshopCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  questionnaire Questionnaire?     @relation("WorkshopQuestionnaire", fields: [questionnaireId], references: [id], onDelete: SetNull)
  artisans  WorkshopArtisan[]
  crafts    WorkshopCraft[]
  products  ProductDocumentation[]
  tools     ToolDocumentation[]
  media     MediaFile[]
  assignments WorkshopAssignment[] @relation("WorkshopAssignments")
  tasks       AssignedTask[]       @relation("TaskWorkshop")
  // Back-relations for the EXPLICIT workshopId column on the remaining record types. `artisans` /
  // `crafts` above are the join-table links; these are the direct ones, kept in lock-step for
  // artisans and crafts so both readings of "who was at this workshop" agree.
  artisansLinked          Artisan[]                @relation("ArtisanWorkshop")
  craftsLinked            Craft[]                  @relation("CraftWorkshop")
  processes               Process[]                @relation("ProcessWorkshop")
  questionnaireInterviews QuestionnaireInterview[] @relation("InterviewWorkshop")

  // `startDate` is both the list's primary sort key and the column its date-range filter reads;
  // `date` is what the task-assignment picker orders by. `endDate` is only ever read off a row that
  // has already been fetched, so it is not indexed.
  @@index([date])
  @@index([startDate])
  @@index([createdById])
  @@index([status])
  @@index([questionnaireId])
  // The picker filters on the type and orders by date; one composite index serves both. Equality
  // first, then the sort column, for the reason the Artisan block above gives.
  @@index([workshopType, startDate])
  // Not the list order (that is startDate) — this is for the review queue and the dashboard's
  // "recent submissions", which order workshops by createdAt like every other record type.
  @@index([createdAt])
}

model WorkshopArtisan {
  workshopId String
  artisanId  String
  role       String?
  createdAt  DateTime @default(now())

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  artisan  Artisan  @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@id([workshopId, artisanId])
  @@index([artisanId])
}

model WorkshopCraft {
  workshopId String
  craftId    String
