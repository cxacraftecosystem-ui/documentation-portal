# ---------------------------------------------------------------------------------------------
# Field Repository — LOCAL DOCKER environment.
#
#     cp .env.docker.example .env
#
# Compose reads `.env` from the repository root automatically and uses it to fill the
# `${VAR:-default}` slots in docker-compose.yml. Every value here is already the default baked
# into that file, so THIS FILE IS OPTIONAL — the stack runs correctly without it. Copy it when you
# want to override something: an AI provider key, a port that collides with something you already
# have running.
#
#
#   ###########################################################################################
#   ##                                                                                       ##
#   ##   backend/.env IS THE PRODUCTION ENVIRONMENT. IT MUST NEVER REACH A CONTAINER.        ##
#   ##                                                                                       ##
#   ###########################################################################################
#
# That file holds the live Supabase pooler URL, the real JWT signing secret and the AWS keys for
# the bucket holding every researcher's uploaded media. It is NOT a template with a few real
# values in it — it is the running production configuration, kept on disk so the deploy workflow
# can ship it. This file is its opposite: throwaway credentials for throwaway containers.
#
# So never, under any circumstance, do this:
#
#     docker compose run --rm --env-file backend/.env api      # <- catastrophe
#     docker compose --env-file backend/.env up                # <- the same catastrophe
#
# A container that came up on those values would be serving, editing and deleting real records
# from a sandbox nobody is watching, and if MEDIA_QUEUE_WORKER_ENABLED came along with them it
# would also start a SECOND transcription worker against the live queue — re-processing jobs the
# real box is already running, burning the AI provider quota twice, and writing both results back.
#
# Three separate things stand in the way, and you should know all three, because a guard you
# cannot name is a guard you will eventually disable:
#
#   1. .dockerignore excludes **/.env from the build context, so no image can bake it in.
#   2. docker/backend/entrypoint.sh parses DATABASE_URL before uvicorn is exec'd and REFUSES to
#      start when the host is remote. This is the one that catches the command above.
#   3. Compose passes only the variables named in docker-compose.yml, so a stray value in a file
#      you did not intend to load does not silently become part of the container's environment.
#
# The first two are the load-bearing ones. Neither is a reason to be casual with the third.
#
# Full prose: docs/DOCKER.md
# ---------------------------------------------------------------------------------------------


# =============================================================================================
# Host ports
#
# Change these when something already owns the port. The web image's build args are interpolated
# from the SAME variables, so the bundle the browser downloads always points at the port you
# actually published — but NEXT_PUBLIC_* is inlined at build time, so changing API_HOST_PORT
# means `docker compose --profile web up --build`, not just a restart.
# =============================================================================================
API_HOST_PORT=8000
WEB_HOST_PORT=3000


# =============================================================================================
# Database
#
# `postgres` is the compose service name; 5432 is the port INSIDE the network. The host reaches
# the same database on 55432 (the published mapping dodges a locally installed PostgreSQL).
#
# The entrypoint guard classifies `postgres`, `localhost`, `db`, `host.docker.internal`, any
# private/loopback IP and any *.local / *.internal name as local. Anything else is refused.
# =============================================================================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/field_repository

# The escape hatch, shown here COMMENTED so you have read what it does before you use it. It
# permits a remote DATABASE_URL — intended for a read-only look at a staging database, never for
# Supabase. If you do set it, leave MEDIA_QUEUE_WORKER_ENABLED=false.
# ALLOW_REMOTE_DATABASE=yes-i-mean-it


# =============================================================================================
# Auth
#
# Long enough to satisfy the startup check (the API refuses to boot on a short or placeholder
# secret) and worthless to anyone, because it is committed in a public example file. That is the
# point: a local-only secret should be obviously local. Never reuse this anywhere real.
# =============================================================================================
JWT_SECRET=local-docker-jwt-signing-key-6f2ab41d9c7e5083bd14a27fe6c390b8
JWT_EXPIRES_MINUTES=10080

MASTER_ADMIN_EMAIL=admin@example.com
MASTER_ADMIN_NAME=Local Admin


# =============================================================================================
# Media storage — MinIO, not S3
#
# AWS_S3_ENDPOINT is what the API signs against, from inside the network. AWS_S3_PUBLIC_BASE_URL
# is where a BROWSER later fetches the object, and a browser cannot resolve `minio` — hence
# localhost. Get these the same way round and uploads succeed but nothing renders.
#
# Server-side encryption stays empty: MinIO has no KMS backend here and rejects the SSE header
# outright, so a non-empty value fails every API-initiated multipart upload. docker-compose.yml
# hard-codes the empty value rather than reading it from here, because there is no correct
# alternative for this stack.
# =============================================================================================
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET=field-repository
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_PUBLIC_BASE_URL=http://localhost:9000/field-repository


# =============================================================================================
# API behaviour
# =============================================================================================

# Comma-separated, exact origins, no trailing slash. Widen this if you serve the web app from
# somewhere other than the published port.
BACKEND_CORS_ORIGINS=http://localhost:3000

# /docs, /redoc and /openapi.json. Off in production by default; on here, since the schema is the
# fastest way to find the route you are looking for.
BACKEND_EXPOSE_DOCS=true

# Off over plain http://. Enabling it would teach your browser to refuse http://localhost for two
# years — for every project on this machine, not just this one.
SECURITY_HSTS_ENABLED=false

# OFF, which is the opposite of the application's own default. The queue drains real transcription
# and media jobs; leave it off unless you are specifically exercising the queue, and never turn it
# on in the same breath as ALLOW_REMOTE_DATABASE.
MEDIA_QUEUE_WORKER_ENABLED=false


# =============================================================================================
# AI provider keys — all optional, all blank
#
# Blank is a working configuration: the transcription chain reports that no provider is available
# instead of failing. Fill one in only to exercise that path, and remember these are real,
# metered credentials in a file that is gitignored but still sitting on your disk.
# =============================================================================================
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=


# =============================================================================================
# Web build args
#
# Inlined into the JavaScript bundle at build time, so a change here needs `--build`. Neither can
# be a secret: both are readable by anyone who opens devtools.
# =============================================================================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_MAPTILER_API_KEY=


# =============================================================================================
# Optional scale layer — DORMANT
#
# `docker compose --profile cache up` starts a Redis. Starting it changes nothing on its own: the
# API does not connect to Redis, does not import a Redis client, and does not declare a dependency
# on the container. It sits there until the flags below say otherwise, and they are commented out.
#
# Uncomment all three together — a backend of `redis` with no URL, or a URL with the cache off, is
# a configuration that looks enabled and is not. If the flags are on and Redis is unreachable, the
# API logs the failure once and serves from its in-process fallback rather than erroring.
#
# The URL differs by vantage point: `redis://redis:6379/0` from inside the compose network,
# `redis://localhost:56379/0` from a shell on your machine.
#
# These variables are read by backend/app/scale. If that package is not present in your checkout,
# setting them does nothing at all.
# =============================================================================================
# SCALE_CACHE_ENABLED=true
# SCALE_CACHE_BACKEND=redis
# SCALE_REDIS_URL=redis://redis:6379/0
