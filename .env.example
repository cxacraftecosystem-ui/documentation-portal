# ---------------------------------------------------------------------------------------------
# Field Repository — monorepo environment reference
#
# This file lists EVERY environment variable used anywhere in the repository, in one place, so you
# can see the whole surface at a glance. Nothing loads this file directly — each service reads its
# own file, so copy the values you need into the right place:
#
#   backend/.env         <- backend/.env.example        (FastAPI + Prisma + S3 + AI keys)
#   frontend/.env.local  <- frontend/.env.local.example (NEXT_PUBLIC_* only, inlined into the bundle)
#   android/local.properties                            (apiBaseUrl — not an env var; see README)
#   GitHub Actions secrets                              (BACKEND_ENV, EC2_HOST, EC2_SSH_KEY, …)
#   Vercel dashboard                                    (the NEXT_PUBLIC_* set — docs/DEPLOYMENT_VERCEL.md)
#
# Required vs optional, defaults, and which values are secrets: docs/ENVIRONMENT.md
# Never commit real credentials — this file and every *.example file hold placeholders only.
# ---------------------------------------------------------------------------------------------

# =============================================================================================
# Backend (backend/.env) — see backend/.env.example for the fully annotated version
# =============================================================================================

# Prisma connection string. Use the Supabase SESSION pooler URL (:5432) so migrations work; the app
# re-routes its runtime queries to the transaction pooler (:6543) by itself. SECRET.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/field_repository
# DATABASE_USE_TRANSACTION_POOLER=true   # default true
# DATABASE_CONNECTION_LIMIT=10           # default 10 per uvicorn worker; raising it exhausted the pooler
# DATABASE_POOL_TIMEOUT=10               # default: Prisma's own (10s)
# DATABASE_REQUIRE_SSL=                  # unset = auto (sslmode=require for remote hosts only)

# JWT signing secret (SECRET) and token lifetime in minutes.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_MINUTES=10080
# JWT_ALGORITHM=HS256                    # HS256/HS384/HS512 only; anything else refuses to start
# ALLOW_WEAK_JWT_SECRET=false            # local dev only — boots with a placeholder JWT_SECRET

# Security response headers (app.main.SecurityHeadersMiddleware). Set SECURITY_FORCE_HSTS=true in
# production: nginx overwrites X-Forwarded-Proto, so the app cannot see that the viewer used TLS.
# SECURITY_HSTS_ENABLED=true
# SECURITY_HSTS_MAX_AGE=63072000
# SECURITY_FORCE_HSTS=false

# S3-compatible media storage. AWS_SECRET_ACCESS_KEY is SECRET.
# Leave AWS_S3_ENDPOINT UNSET on real AWS so boto3 signs the dual-stack regional endpoint
# (needed for uploads from IPv6-only mobile networks). The values below are local MinIO.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET=field-repository
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_PUBLIC_BASE_URL=http://localhost:9000/field-repository
# AWS_S3_SSE_ALGORITHM=AES256            # SSE for API-initiated multipart uploads; EMPTY for MinIO

# Public origin of the web app, and the exact browser origins allowed to call the API.
# BACKEND_CORS_ORIGINS is comma-separated, no trailing slashes, no wildcards — every Vercel
# production/preview/custom domain that must reach the API has to be listed here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Google OAuth client IDs used to verify incoming ID tokens. Not secret.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Master administrator (required) and the tier given to brand-new self-registered Google accounts.
MASTER_ADMIN_EMAIL=ankits1802@gmail.com
MASTER_ADMIN_NAME=Ankit Kumar
DEFAULT_SIGNUP_ROLE=CROWDSOURCE_VOLUNTEER

# Speech-to-text chain (priority: ElevenLabs -> Deepgram -> OpenAI Whisper) and transcript
# refinement/translation. Every *_API_KEY here is SECRET; all are optional.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini
# Gemini grid-measurement vision. GEMINI_API_KEYS accepts many comma/newline-separated keys and the
# worker rotates across them.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MEASUREMENT_MODEL=gemini-2.5-flash-lite

# Durable media/transcription queue. Set MEDIA_QUEUE_WORKER_ENABLED=false on the web process in
# production — the separate fieldrepo-queue service drains the queue there.
# MEDIA_QUEUE_WORKER_ENABLED=true
# MEDIA_QUEUE_INTERVAL_SECONDS=5
# MEDIA_QUEUE_BATCH_SIZE=3
# MEDIA_QUEUE_JOB_MAX_ATTEMPTS=3

# Optional Supabase REST/Admin access (not read by the API today). SUPABASE_SECRET_KEY is SECRET.
SUPABASE_REST_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# First email/password admin, created by backend/scripts/seed_admin.py. ADMIN_PASSWORD is SECRET.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Repository Admin
ADMIN_PASSWORD=

# =============================================================================================
# Frontend (frontend/.env.local, or the Vercel dashboard)
# Every NEXT_PUBLIC_* value is INLINED into the JavaScript bundle at build time: none of them can
# be a secret, and changing one in Vercel requires a REDEPLOY to take effect.
# =============================================================================================

# ORIGIN ONLY — no `/api` suffix, no trailing slash. lib/api.ts appends `/api` itself, so
# `…/api` here yields `…/api/api/...` and every request 404s. Production: https://d2b34i3e92al6i.cloudfront.net
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public origin of the web app itself (keep in sync with the backend value of the same name).
# NEXT_PUBLIC_APP_URL=http://localhost:3000   # already set in the backend block above
# Google web OAuth client ID — same value as GOOGLE_CLIENT_ID. Optional; blank hides the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# MapTiler key for the map coordinate picker. Optional; blank falls back to manual lat/long entry.
NEXT_PUBLIC_MAPTILER_API_KEY=

# =============================================================================================
# Repository automation (GitHub Actions secrets — never a local file)
# =============================================================================================

# .github/workflows/keep-supabase-active.yml -> npm run keep-alive (scripts/keep-supabase-active.mjs).
# The script picks the first of SUPABASE_KEEPALIVE_URL / SUPABASE_DATABASE_URL / DATABASE_URL and
# auto-rewrites a Supabase pooler URL from :5432 to :6543 (a session-mode keep-alive is rejected
# with EMAXCONNSESSION because the live backend already holds those 15 slots). SECRET.
SUPABASE_KEEPALIVE_URL=
SUPABASE_DATABASE_URL=
# Set "true" to disable the :5432 -> :6543 rewrite above (only for a non-Supabase database).
SUPABASE_KEEPALIVE_NO_REWRITE=
# Set "false" to disable TLS for the keep-alive connection; anything else keeps SSL on.
SUPABASE_DB_SSL=

# .github/workflows/deploy-backend.yml also needs these repository secrets (set in GitHub, not here):
#   EC2_HOST      the Elastic IP of the API box
#   EC2_SSH_KEY   the private .pem contents for that EC2 key pair
#   BACKEND_ENV   the ENTIRE backend/.env file contents, piped to the box over SSH
