{
  "contract": "session-title",
  "version": 1,
  "owner": "feature/q-backend (written once; WEB, ANDROID and the designer portal copy this file verbatim)",
  "convention": "C:/dev/IIT/docs/conventions/NAMING_2026-10-18.md",
  "enforcedBy": [
    "backend/tests/test_naming.py",
    "frontend/e2e/naming-unit.spec.ts",
    "android/app/src/test/java/com/fieldrepository/app/data/NamingTest.kt"
  ],
  "rules": {
    "titleGrammar": "Entity_Date_Place_Craft_Subject",
    "fileGrammar": "Portal_Entity_Date[_Time]_Place_Craft_Subject_What[_Sequence][_n].ext",
    "portal": "FieldRepository (designer portal: DesignWorkshop)",
    "separators": "'_' between fields, '-' between the words of one field. Nothing else is a separator.",
    "unknownField": "Left out entirely. Never 'Unknown', 'NA' or a guess.",
    "entity": "Interview for 0 or 1 participant; Group-Interview for 2 or more. An explicit `entity` (designer portal: Workshop) overrides.",
    "date": "Titles: sessionDate as YYYY-MM-DD. Recordings: the IST date of capturedAt. Exports and reports: the IST generation day.",
    "time": "Recordings only: HHMM (24 h, IST) of capturedAt. Left out when capturedAtSource is SESSION_DATE, UPLOAD_TIME or UPLOAD_TIME_OUT_OF_WINDOW.",
    "place": "The session place; else the workshop's 'locality district' (district dropped when it equals the locality); else locality; else district; else state.",
    "craft": "The workshop's craft; else the craft every participant shares (compared case-insensitively over words); else left out.",
    "subject": "1 participant: the artisan's name (file names prefer a stored ASCII name, name then localName, before transliterating). 2 or more: '<N> Artisans'. None: left out. An explicit `subject` (a code) overrides.",
    "words": "Text is NFC-normalised and split into words at every character that is not a letter (L*), a mark (M*), a decimal digit (Nd), ZWNJ or ZWJ. Each word is Title-Cased: first character upper, the rest lower, except a word containing a digit or an all-upper-case ASCII word of 2-3 letters, which keeps its case. Words without case (Devanagari) are unchanged.",
    "transliteration": "File names only. (1) Indic inherent vowel: in the blocks starting U+0900, 0980, 0A00, 0A80, 0B00, 0B80, 0C00, 0C80 and 0D00, a consonant (block offset 0x15-0x39 or 0x58-0x5F), after every nukta (0x3C) has been dropped, gets an ASCII 'a' inserted after it when the next character is in the same block, is not a vowel sign or virama (0x3E-0x4D, 0x55-0x57, 0x62-0x63) and is a letter (consonant, independent vowel 0x05-0x14 or 0x60-0x61, or candrabindu/anusvara/visarga 0x01-0x03). A consonant at the end of a word gets nothing. (2) anyascii 0.3.x (Python anyascii, npm any-ascii, Java com.anyascii:anyascii). (3) The words rule, keeping only [A-Za-z0-9] inside a word. Android must use the anyascii Java library, not ICU Any-Latin, or its rows will differ (ICU writes the inherent vowels anyascii drops).",
    "sequence": "One question target: <Section>-Q<nn> from the display code (F7 -> F-Q07). A section target: <Section>-All. Several questions of one section: <Section>-Q<first>-Q<last>. Several sections: their pieces joined with '-' in target order. Whole session: left out. Then '-P<n>' for a continuation (part n >= 2), else '-T<n>' for a solo take (rosterCount 1) at position n >= 2. Group takes never carry -T. With no section piece the suffix stands alone.",
    "length": "Counted in Unicode code points. Titles <= 120, file names <= 150 including the extension. Shorten in order: drop Subject's last word while Subject is longer than 40; then Craft's last word down to one; then Place's down to one; then Subject's down to one; then drop Craft; then drop Place; then cut Subject's last character; then drop Subject. Portal, Entity, Date, Time, What, Sequence, n and the extension are never cut.",
    "collisions": "Within one folder or zip, the 2nd, 3rd ... identical name (case-insensitive) gets _2, _3 before the extension (.sql.gz counts as one extension), in (createdAt, id) order.",
    "reservedStems": "A stem equal to CON, PRN, AUX, NUL, COM1-9 or LPT1-9 gets '-File' appended.",
    "s3Key": "media/<userId>/<uuid32hex>/<file name>; the server mints the leaf at presign. Existing keys are never renamed."
  },
